---
import Base from '../layouts/Base.astro';
import TerminalHero from '../components/TerminalHero.astro';
import Features from '../components/Features.astro';
import ProviderGrid from '../components/ProviderGrid.astro';
import Terminal from '../components/Terminal.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { REPO_URL } from '../consts';

const quickstart = [
  'ccx new                  # create a profile (wizard or flags)',
  'ccx list                 # list profiles',
  'ccx claude               # Anthropic: Opus plans, Sonnet executes',
  'ccx glm -p "hello"       # run an isolated third-party profile',
  'ccx show <name>          # inspect a profile (token masked)',
  'ccx rm <name>            # delete a profile',
].join('\n');
---
<Base>
  <TerminalHero />
  <Features />

  <!-- Quick start -->
  <section class="mx-auto max-w-4xl px-5 py-16">
    <h2 class="font-mono text-sm text-muted">
      <span class="t-prompt">$</span> ccx --help
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-muted">
      Each profile is just environment variables around the
      <code class="font-mono t-accent">claude</code> binary. Create one, launch it by name.
    </p>
    <div class="mt-6">
      <CodeBlock code={quickstart} />
    </div>
  </section>

  <ProviderGrid />

  <!-- GUI -->
  <section class="mx-auto max-w-4xl px-5 py-16">
    <h2 class="font-mono text-sm text-muted">
      <span class="t-prompt">$</span> ccx --gui
    </h2>
    <div class="mt-6">
      <Terminal title="ccx-gui — desktop">
        <div class="font-mono text-sm leading-relaxed">
          <p><span class="t-ok">◇</span> Tauri + Svelte desktop profile manager</p>
          <p class="mt-2 text-muted">
            Create, edit, launch, and copy commands from a window. Profiles are stored
            exactly like the CLI (<span class="t-blue">~/.config/ccx</span>, mode 600) —
            fully interchangeable. The token never touches the clipboard.
          </p>
          <a
            href="/docs/desktop-gui/"
            class="mt-4 inline-block text-accent hover:text-blue"
          >→ about the desktop GUI</a>
        </div>
      </Terminal>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="mx-auto max-w-4xl px-5 pb-10">
    <div class="rounded-xl border border-accent/30 bg-[color-mix(in_oklab,var(--color-accent)_6%,transparent)] p-7">
      <h2 class="font-mono text-sm t-accent">
        <span class="t-prompt">$</span> ccx --roadmap
      </h2>
      <p class="mt-3 max-w-2xl font-mono text-[0.85rem] leading-relaxed text-muted">
        OpenAI-only providers (OpenAI, OpenRouter, Ollama, …) through a
        <span class="text-fg">local Anthropic ⇄ OpenAI router</span>, managed per profile.
      </p>
      <div class="mt-5 flex gap-5 font-mono text-sm">
        <a href="/docs/roadmap/" class="t-accent hover:text-blue">→ read the plan</a>
        <a href={REPO_URL} target="_blank" rel="noreferrer" class="text-muted hover:text-fg">→ contribute</a>
      </div>
    </div>
  </section>
</Base>
