#!/usr/bin/env bash
set -euo pipefail
umask 077

CCX_HOME="${CCX_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/ccx}"
CCX_CLAUDE_BIN="${CCX_CLAUDE_BIN:-claude}"
CCX_ROUTER_BIN="${CCX_ROUTER_BIN:-ccx-router}"
CCX_CURL_BIN="${CCX_CURL_BIN:-curl}"
CCX_VERSION="0.1.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf 'ccx: %s\n' "$1" >&2; exit "${2:-1}"; }

resolve_router_bin() { # print the ccx-router binary path, or fail
  if command -v "$CCX_ROUTER_BIN" >/dev/null 2>&1; then printf '%s' "$CCX_ROUTER_BIN"; return 0; fi
  if [ "$CCX_ROUTER_BIN" = "ccx-router" ] && [ -x "$SCRIPT_DIR/../router/target/release/ccx-router" ]; then
    printf '%s/../router/target/release/ccx-router' "$SCRIPT_DIR"; return 0
  fi
  return 1
}

profiles_dir() { printf '%s/profiles' "$CCX_HOME"; }
profile_dir()  { printf '%s/profiles/%s' "$CCX_HOME" "$1"; }
profile_env()  { printf '%s/profiles/%s/profile.env' "$CCX_HOME" "$1"; }

valid_profile_name() { # a safe profile name: no slashes/dots/spaces, so the path
  # can't escape the profiles dir (guards run/show/edit/rm against traversal).
  printf '%s' "${1:-}" | grep -qE '^[A-Za-z0-9_-]+$'
}

template_file() { # echo template path for a provider, or nothing
  if [ -f "$CCX_HOME/providers/$1.tmpl" ]; then
    printf '%s/providers/%s.tmpl' "$CCX_HOME" "$1"
  elif [ -f "$SCRIPT_DIR/../providers/$1.tmpl" ]; then
    printf '%s/../providers/%s.tmpl' "$SCRIPT_DIR" "$1"
  fi
}

kv_get() { # file key -> value (first match)
  awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$1"
}

print_provider_names() { # list provider template names, user templates overriding bundled ones
  local -a preferred=(claude minimax glm deepseek kimi openai openrouter ollama vllm lmstudio sakana custom-oai)
  local seen="" n dir t base
  for n in "${preferred[@]}"; do
    if [ -n "$(template_file "$n")" ]; then
      printf '%s\n' "$n"
      seen="$seen $n "
    fi
  done
  for dir in "$CCX_HOME/providers" "$SCRIPT_DIR/../providers"; do
    [ -d "$dir" ] || continue
    for t in "$dir"/*.tmpl; do
      [ -e "$t" ] || continue
      base="$(basename "$t" .tmpl)"
      case " $seen " in *" $base "*) ;; *) printf '%s\n' "$base"; seen="$seen $base " ;; esac
    done
  done
}

tui_select() { # interactive arrow-key selector; sets tui_selected (0-based index)
  # Usage: tui_select "header" "item1" "item2" ...
  # Global: tui_subtitles[] — optional per-item description (parallel to args)
  local header="$1"; shift
  local -a items=("$@")
  local count="${#items[@]}"
  [ "$count" -gt 0 ] || { tui_selected=-1; return 1; }

  local i cur=0
  # Start on the first selectable row — group headers (containing '│') are not
  # selectable, so landing the cursor on one lets Enter create an invalid profile.
  while [ "$cur" -lt "$count" ] && [[ "${items[$cur]}" == *│* ]]; do cur=$((cur + 1)); done
  [ "$cur" -lt "$count" ] || cur=0

  # --- layout precompute -------------------------------------------------
  # Terminal width bounds the box; fall back to 80 columns when unknown.
  local cols; cols="$(tput cols 2>/dev/null || printf '80')"
  case "$cols" in '' | *[!0-9]*) cols=80 ;; esac

  # Classify rows: a '│' marks a non-selectable group header, everything else is
  # a provider/model row with an optional dim subtitle. Names of subtitled rows
  # share one column width so their subtitles line up.
  local -a it_hdr=() it_name=() it_sub=()
  local j name_w=0 body_w=0 bl
  for ((j = 0; j < count; j++)); do
    if [[ "${items[$j]}" == *│* ]]; then
      it_hdr[$j]=1; it_name[$j]="${items[$j]#│ }"; it_sub[$j]=""
    else
      it_hdr[$j]=0; it_name[$j]="${items[$j]}"; it_sub[$j]="${tui_subtitles[$j]:-}"
      [ -n "${it_sub[$j]}" ] && [ "${#it_name[$j]}" -gt "$name_w" ] && name_w="${#it_name[$j]}"
    fi
  done
  for ((j = 0; j < count; j++)); do
    if [ -n "${it_sub[$j]}" ]; then bl=$((name_w + 2 + ${#it_sub[$j]})); else bl="${#it_name[$j]}"; fi
    [ "$bl" -gt "$body_w" ] && body_w="$bl"
  done

  local title="${header%:}"
  local hint='↑↓ move · ⏎ select · q cancel'
  # Interior width = 3-col marker gutter + widest body + 1-col right margin,
  # widened if the title or hint embedded in the borders needs more room, then
  # clamped to the terminal.
  local inner=$((3 + body_w + 1))
  [ $(( ${#title} + 4 )) -gt "$inner" ] && inner=$(( ${#title} + 4 ))
  [ $(( ${#hint} + 4 ))  -gt "$inner" ] && inner=$(( ${#hint} + 4 ))
  local max_inner=$((cols - 2))
  [ "$max_inner" -ge 12 ] && [ "$inner" -gt "$max_inner" ] && inner="$max_inner"

  # Dim borders/subtitles; reverse-cyan bar marks the selected row (adapts to any
  # light/dark theme since it swaps the terminal's own colors).
  local R=$'\033[0m' DIM=$'\033[2m' BRD=$'\033[2m' SEL=$'\033[7;36;1m'

  tui_dashes() { local s; printf -v s '%*s' "$1" ''; printf '%s' "${s// /─}"; }

  tui_line() { # $1 = item index — print one bordered interior line + CRLF
    local nm="${it_name[$1]}" sb="${it_sub[$1]}" hdr="${it_hdr[$1]}"
    local plain avail dlen pad sp
    if [ "$hdr" = 1 ] || [ -z "$sb" ]; then plain="$nm"
    else printf -v plain '%-*s  %s' "$name_w" "$nm" "$sb"; fi
    avail=$((inner - 3))
    if [ "${#plain}" -gt "$avail" ]; then plain="${plain:0:$((avail - 1))}…"; sb=""; fi
    dlen="${#plain}"; pad=$((avail - dlen)); [ "$pad" -lt 0 ] && pad=0
    printf -v sp '%*s' "$pad" ''
    if [ "$1" -eq "$cur" ] && [ "$hdr" != 1 ]; then
      printf '%s│%s%s ▸ %s%s%s%s│%s\r\n' "$BRD" "$R" "$SEL" "$plain" "$sp" "$R" "$BRD" "$R"
    elif [ "$hdr" = 1 ]; then
      printf '%s│%s   %s%s%s%s%s│%s\r\n' "$BRD" "$R" "$DIM" "$plain" "$R" "$sp" "$BRD" "$R"
    elif [ -n "$sb" ]; then
      printf '%s│%s   %-*s  %s%s%s%s%s│%s\r\n' "$BRD" "$R" "$name_w" "$nm" "$DIM" "$sb" "$R" "$sp" "$BRD" "$R"
    else
      printf '%s│%s   %s%s%s│%s\r\n' "$BRD" "$R" "$plain" "$sp" "$BRD" "$R"
    fi
  }

  tui_pad_line() { printf '%s│%s%*s%s│%s\r\n' "$BRD" "$R" "$inner" '' "$BRD" "$R"; }

  tui_draw() { # full box top-to-bottom; cursor ends on the blank line below it
    printf '%s╭─ %s%s%s %s╮%s\r\n' "$BRD" "$R" "$title" "$BRD" "$(tui_dashes $((inner - 3 - ${#title})))" "$R"
    tui_pad_line
    for ((j = 0; j < count; j++)); do tui_line "$j"; done
    tui_pad_line
    printf '%s╰─ %s %s╯%s\r\n' "$BRD" "$hint" "$(tui_dashes $((inner - 3 - ${#hint})))" "$R"
  }

  tui_redraw() { # repaint only the item rows in place
    printf '\r\033[%dA' "$((count + 2))"   # up to the first item row
    for ((j = 0; j < count; j++)); do tui_line "$j"; done
    printf '\033[2B\r'                       # back down to the blank line below the box
  }

  printf '\n'
  tui_draw

  if [ ! -t 0 ] || ! command -v stty >/dev/null 2>&1; then
    printf '\n'
    tui_selected=-1; return 1
  fi

  local saved_stty; saved_stty="$(stty -g)"
  stty raw -echo isig min 0 time 1 2>/dev/null || { printf '\n'; tui_selected=-1; return 1; }
  trap 'stty "$saved_stty" 2>/dev/null; trap - INT TERM' INT TERM

  local key ok=0
  while true; do
    IFS= read -rsn1 key || { ok=-1; break; }
    case "$key" in
      $'\x1b')
        local c1 c2; IFS= read -rsn1 -t 0.1 c1; IFS= read -rsn1 -t 0.1 c2
        if [ "$c1$c2" = "[A" ]; then
          local ni=$((cur - 1))
          while [ "$ni" -ge 0 ] && [[ "${items[$ni]}" == *│* ]]; do ni=$((ni - 1)); done
          [ "$ni" -ge 0 ] && { cur=$ni; tui_redraw; }
        elif [ "$c1$c2" = "[B" ]; then
          local ni=$((cur + 1))
          while [ "$ni" -lt "$count" ] && [[ "${items[$ni]}" == *│* ]]; do ni=$((ni + 1)); done
          [ "$ni" -lt "$count" ] && { cur=$ni; tui_redraw; }
        fi
        ;;
      '') ok=1; break ;;
      q|Q) ok=-1; break ;;
    esac
  done

  stty "$saved_stty" 2>/dev/null
  trap - INT TERM

  # The cursor rests on the blank line just below the box; clear it so the next
  # prompt starts cleanly there.
  printf '\r\033[2K'

  if [ "$ok" -eq 1 ]; then tui_selected="$cur"; return 0
  else tui_selected=-1; return 1; fi
}

choose_provider() { # set caller's $provider from interactive menu or typed name
  local -a providers=() t_items=() t_subs=() t_sel=()
  local p tf router model i ans custom_idx
  while IFS= read -r p; do providers+=("$p"); done < <(print_provider_names)

  tui_subtitles=()
  t_items+=("│ Anthropic-compatible")
  t_subs+=("")
  for p in "${providers[@]}"; do
    tf="$(template_file "$p")"
    router="$(kv_get "$tf" CCX_ROUTER)"
    [ -z "$router" ] || continue
    model="$(kv_get "$tf" ANTHROPIC_MODEL)"
    t_items+=("$p")
    t_subs+=("${model:+($model)}")
  done
  t_items+=("│ OpenAI-compatible (via ccx-router)")
  t_subs+=("")
  for p in "${providers[@]}"; do
    tf="$(template_file "$p")"
    router="$(kv_get "$tf" CCX_ROUTER)"
    [ -n "$router" ] || continue
    model="$(kv_get "$tf" ANTHROPIC_MODEL)"
    t_items+=("$p")
    t_subs+=("${model:+($model)}")
  done
  t_items+=("Custom / type manually")
  t_subs+=("")
  tui_subtitles=("${t_subs[@]}")

  if [ -t 0 ] && tui_select "Choose provider:" "${t_items[@]}"; then
    local chosen="${t_items[$tui_selected]}"
    if [ "$chosen" = "Custom / type manually" ]; then
      printf 'Provider name: '; read -r provider || true
    else
      provider="$chosen"
    fi
  else
    # Fallback: numbered menu
    local -a menu=()
    printf 'Choose provider (or type a provider name):\n'
    printf 'Anthropic-compatible:\n'
    for p in "${providers[@]}"; do
      tf="$(template_file "$p")"
      router="$(kv_get "$tf" CCX_ROUTER)"
      [ -z "$router" ] || continue
      model="$(kv_get "$tf" ANTHROPIC_MODEL)"
      menu+=("$p")
      printf '  %2d) %-12s %s\n' "${#menu[@]}" "$p" "${model:+($model)}"
    done
    printf 'OpenAI-compatible (via ccx-router):\n'
    for p in "${providers[@]}"; do
      tf="$(template_file "$p")"
      router="$(kv_get "$tf" CCX_ROUTER)"
      [ -n "$router" ] || continue
      model="$(kv_get "$tf" ANTHROPIC_MODEL)"
      menu+=("$p")
      printf '  %2d) %-12s %s\n' "${#menu[@]}" "$p" "${model:+($model)}"
    done
    custom_idx=$((${#menu[@]} + 1))
    printf '  %2d) Custom / type manually\n' "$custom_idx"
    printf 'Provider [1]: '
    read -r ans || true
    if [ -z "$ans" ]; then ans=1; fi
    case "$ans" in
      *[!0-9]*) provider="$ans" ;;
      *)
        if [ "$ans" -ge 1 ] && [ "$ans" -le "${#menu[@]}" ]; then
          provider="${menu[$((ans - 1))]}"
        elif [ "$ans" -eq "$custom_idx" ]; then
          printf 'Provider name: '
          read -r provider || true
        else
          die "invalid provider choice: $ans"
        fi
        ;;
    esac
  fi
}

fetch_models() { # url mode token — print model ids (one per line); nonzero on failure
  local url="$1" mode="$2" tok="$3" body rc=0 header=""
  command -v "$CCX_CURL_BIN" >/dev/null 2>&1 || return 1
  case "$tok" in *$'\n'* | *$'\r'*) return 1 ;; esac
  if [ "$mode" = "anthropic" ]; then
    header='anthropic-version: 2023-06-01'
    [ -n "$tok" ] && header="$header"$'\n'"x-api-key: $tok"
  else
    [ -n "$tok" ] && header="Authorization: Bearer $tok"
  fi
  # -f fails on HTTP >=400 (e.g. 401 without a key) so we cleanly fall back.
  # Header material is streamed over stdin (`-H @-`) so credentials never
  # appear in curl's argv or a temporary file. Cap the body before placing it
  # in a shell variable so a hostile discovery endpoint cannot exhaust memory.
  if [ -n "$header" ]; then
    body="$(printf '%s\n' "$header" | "$CCX_CURL_BIN" -fsS --max-time 12 --max-filesize 1048576 \
      -H @- "$url" 2>/dev/null)" || rc=$?
  else
    body="$("$CCX_CURL_BIN" -fsS --max-time 12 --max-filesize 1048576 "$url" 2>/dev/null)" || rc=$?
  fi
  [ "$rc" -eq 0 ] || return 1
  [ -n "$body" ] || return 1
  # Both OpenAI- and Anthropic-shaped responses list ids under .data[].id.
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$body" | jq -r '.data[]?.id // empty' 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    printf '%s' "$body" | python3 -c 'import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
for m in (d.get("data") or []):
    if isinstance(m,dict) and m.get("id"): print(m["id"])' 2>/dev/null
  else
    printf '%s' "$body" | grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]+"' \
      | sed -E 's/.*:[[:space:]]*"([^"]+)".*/\1/'
  fi
}

tui_filter_select() { # type-to-filter picker; sets tui_selected (0-based into args)
  # Usage: tui_filter_select "header" item1 item2 ...
  local header="${1%:}"; shift
  local -a items=("$@")
  local count="${#items[@]}"
  [ "$count" -gt 0 ] || { tui_selected=-1; return 1; }
  if [ ! -t 0 ] || ! command -v stty >/dev/null 2>&1; then tui_selected=-1; return 1; fi

  # Lowercased copies for case-insensitive matching (bash ${x,,} — no subprocess).
  local i
  local -a lc=()
  for ((i = 0; i < count; i++)); do lc[$i]="${items[$i],,}"; done

  local cols; cols="$(tput cols 2>/dev/null || printf '80')"
  case "$cols" in '' | *[!0-9]*) cols=80 ;; esac

  local vis=$count; [ "$vis" -gt 12 ] && vis=12   # fixed viewport height per call
  local hint='↑↓ move · ⏎ select · type to filter · esc cancel'
  local body_w=0
  for ((i = 0; i < count; i++)); do [ "${#items[$i]}" -gt "$body_w" ] && body_w="${#items[$i]}"; done
  local inner=$((3 + body_w + 1))
  [ $(( ${#header} + 4 )) -gt "$inner" ] && inner=$(( ${#header} + 4 ))
  [ $(( ${#hint} + 4 ))   -gt "$inner" ] && inner=$(( ${#hint} + 4 ))
  local max_inner=$((cols - 2))
  [ "$max_inner" -ge 20 ] && [ "$inner" -gt "$max_inner" ] && inner="$max_inner"

  local R=$'\033[0m' DIM=$'\033[2m' BRD=$'\033[2m' SEL=$'\033[7;36;1m' CY=$'\033[36m' CUR=$'\033[7m \033[0m'
  local H=$((vis + 4))   # lines fs_draw emits: top + query + vis rows + count + bottom
  local query="" cur=0 top=0
  local -a filt=()

  fs_filter() {   # rebuild filt[] from query; reset cursor/scroll
    filt=(); local k lq="${query,,}"
    for ((k = 0; k < count; k++)); do
      if [ -z "$lq" ]; then filt+=("$k"); else case "${lc[$k]}" in *"$lq"*) filt+=("$k") ;; esac; fi
    done
    cur=0; top=0
  }
  fs_pad()  { local s; printf -v s '%*s' "$1" ''; printf '%s' "$s"; }
  fs_dash() { local s; printf -v s '%*s' "$1" ''; printf '%s' "${s// /─}"; }

  fs_row() {   # $1 = filtered position; print one bordered row + CRLF
    local fp="$1" idx txt avail pad sp
    if [ "$fp" -ge "${#filt[@]}" ]; then printf '%s│%s%*s%s│%s\r\n' "$BRD" "$R" "$inner" '' "$BRD" "$R"; return; fi
    idx="${filt[$fp]}"; txt="${items[$idx]}"; avail=$((inner - 3))
    if [ "${#txt}" -gt "$avail" ]; then txt="${txt:0:$((avail - 1))}…"; fi
    pad=$((avail - ${#txt})); [ "$pad" -lt 0 ] && pad=0
    printf -v sp '%*s' "$pad" ''
    if [ "$fp" -eq "$cur" ]; then
      printf '%s│%s%s ▸ %s%s%s%s│%s\r\n' "$BRD" "$R" "$SEL" "$txt" "$sp" "$R" "$BRD" "$R"
    else
      printf '%s│%s   %s%s%s│%s\r\n' "$BRD" "$R" "$txt" "$sp" "$BRD" "$R"
    fi
  }

  fs_draw() {
    printf '%s╭─ %s%s%s %s╮%s\r\n' "$BRD" "$R" "$header" "$BRD" "$(fs_dash $((inner - 3 - ${#header})))" "$R"
    local qavail=$((inner - 4)) qshow="$query"
    [ "${#qshow}" -gt "$qavail" ] && qshow="…${qshow: -$((qavail - 1))}"
    printf '%s│%s %s›%s %s%s%s%s│%s\r\n' "$BRD" "$R" "$CY" "$R" "$qshow" "$CUR" "$(fs_pad $((inner - 4 - ${#qshow})))" "$BRD" "$R"
    local v; for ((v = 0; v < vis; v++)); do fs_row $((top + v)); done
    local info
    if [ "${#filt[@]}" -eq 0 ]; then info="no match"
    elif [ "${#filt[@]}" -eq "$count" ]; then info="$((cur + 1))/$count"
    else info="$((cur + 1))/${#filt[@]} of $count"; fi
    printf '%s│%s   %s%s%s%s%s│%s\r\n' "$BRD" "$R" "$DIM" "$info" "$R" "$(fs_pad $((inner - 3 - ${#info})))" "$BRD" "$R"
    printf '%s╰─ %s %s╯%s\r\n' "$BRD" "$hint" "$(fs_dash $((inner - 3 - ${#hint})))" "$R"
  }
  fs_redraw() { printf '\r\033[%dA' "$H"; fs_draw; }

  fs_filter
  printf '\n'
  for ((i = 0; i < H; i++)); do printf '\n'; done
  printf '\r\033[%dA' "$H"
  fs_draw

  local saved_stty; saved_stty="$(stty -g)"
  stty raw -echo isig min 0 time 1 2>/dev/null || { tui_selected=-1; return 1; }
  trap 'stty "$saved_stty" 2>/dev/null; trap - INT TERM' INT TERM

  local key c1 c2 ok=0
  while true; do
    IFS= read -rsn1 key || { ok=-1; break; }
    case "$key" in
      $'\x1b')
        IFS= read -rsn1 -t 0.1 c1
        if [ "$c1" = '[' ] || [ "$c1" = 'O' ]; then
          IFS= read -rsn1 -t 0.1 c2
          case "$c2" in
            A) if [ "$cur" -gt 0 ]; then cur=$((cur - 1)); [ "$cur" -lt "$top" ] && top="$cur"; fs_redraw; fi ;;
            B) if [ "$cur" -lt $(( ${#filt[@]} - 1 )) ]; then cur=$((cur + 1)); [ "$cur" -ge $((top + vis)) ] && top=$((cur - vis + 1)); fs_redraw; fi ;;
          esac
        else
          ok=-1; break   # bare ESC cancels
        fi
        ;;
      '' | $'\n' | $'\r') ok=1; break ;;
      $'\x7f' | $'\x08') if [ -n "$query" ]; then query="${query%?}"; fs_filter; fs_redraw; fi ;;
      [[:print:]]) query="$query$key"; fs_filter; fs_redraw ;;
    esac
  done

  stty "$saved_stty" 2>/dev/null
  trap - INT TERM
  printf '\r\033[2K'

  if [ "$ok" -eq 1 ] && [ "${#filt[@]}" -gt 0 ]; then tui_selected="${filt[$cur]}"; return 0; fi
  tui_selected=-1; return 1
}

choose_model() { # set caller's $model. Args: provider default_model models_url mode token
  local provider="$1" default_model="$2" url="$3" mode="$4" tok="$5"
  local -a fetched=() items=()
  local m chosen
  if [ -t 0 ] && [ -n "$url" ] && command -v "$CCX_CURL_BIN" >/dev/null 2>&1; then
    printf 'ccx: fetching model list …\n' >&2
    while IFS= read -r m; do [ -n "$m" ] && fetched+=("$m"); done < <(fetch_models "$url" "$mode" "$tok")
  fi
  if [ -t 0 ] && [ "${#fetched[@]}" -gt 0 ]; then
    [ -n "$default_model" ] && items+=("$default_model")
    for m in "${fetched[@]}"; do [ "$m" = "$default_model" ] || items+=("$m"); done
    items+=("Custom / type manually")
    if tui_filter_select "Choose model for $provider" "${items[@]}"; then
      chosen="${items[$tui_selected]}"
      if [ "$chosen" = "Custom / type manually" ]; then printf 'Custom model: '; read -r model || true
      else model="$chosen"; fi
      [ -n "$model" ] || model="$default_model"
      return
    fi
  fi
  # Fallback: template default + manual entry (also the non-curl / offline path).
  if [ -n "$default_model" ]; then printf 'Model [%s]: ' "$default_model"; else printf 'Model: '; fi
  local ans=""; read -r ans || true
  if [ -n "$ans" ]; then model="$ans"; else model="$default_model"; fi
}

mask_token() {
  local t="$1"
  if [ "${#t}" -le 8 ]; then printf '****'; else printf '%s…%s' "${t:0:3}" "${t: -4}"; fi
}

pick_free_port() { # print first free TCP port on loopback in 39000-39999
  local p
  for ((p = 39000; p <= 39999; p++)); do
    # A free port refuses the connection: the subshell's exec fails -> we take it.
    if ! (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then
      printf '%s' "$p"; return 0
    fi
  done
  die "no free port found in 39000-39999"
}

gen_apikey() { # print a random URL-safe token to secure the local router hop
  local k=""
  if [ -r /dev/urandom ]; then
    k="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-24)"
  fi
  [ -n "$k" ] || k="ccx${RANDOM}${RANDOM}${RANDOM}"
  printf '%s' "$k"
}

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# The diagnostic report is deliberately dependency-free and machine-readable.
# Keep check ids and the JSON shape stable: the GUI and other callers consume
# them.  Messages never include configured URLs, credentials, or response bodies.

declare -a DIAG_IDS=() DIAG_LABELS=() DIAG_STATUSES=() DIAG_MESSAGES=() DIAG_REQUIRED=()
DIAG_COMMAND=""
DIAG_PROFILE=""
DIAG_CAP_BASIC="unknown"
DIAG_CAP_STREAMING="unknown"
DIAG_CAP_TOOLS="unknown"

diag_reset() {
  DIAG_COMMAND="$1"; DIAG_PROFILE="${2:-}"
  DIAG_IDS=(); DIAG_LABELS=(); DIAG_STATUSES=(); DIAG_MESSAGES=(); DIAG_REQUIRED=()
  DIAG_CAP_BASIC="unknown"; DIAG_CAP_STREAMING="unknown"; DIAG_CAP_TOOLS="unknown"
}

diag_add() { # id label status message required(true|false)
  DIAG_IDS+=("$1"); DIAG_LABELS+=("$2"); DIAG_STATUSES+=("$3")
  DIAG_MESSAGES+=("$4"); DIAG_REQUIRED+=("$5")
}

json_escape() { # print a JSON string payload without surrounding quotes
  # Diagnostics are built from constants and validated profile names.  Apply
  # substitutions in this order so the backslashes we introduce are retained.
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\b'/\\b}"
  s="${s//$'\f'/\\f}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  # Other C0 controls cannot occur in valid profile names or built-in messages;
  # replace them defensively so even hostile argv still yields valid JSON.
  case "$s" in *[[:cntrl:]]*) s="$(printf '%s' "$s" | LC_ALL=C tr '\001-\010\013\014\016-\037\177' '?')" ;; esac
  printf '%s' "$s"
}

diag_counts() { # set report counters + status globals
  DIAG_PASSED=0; DIAG_WARNINGS=0; DIAG_FAILED=0; DIAG_SKIPPED=0
  DIAG_OVERALL="pass"
  local i st req
  for ((i = 0; i < ${#DIAG_IDS[@]}; i++)); do
    st="${DIAG_STATUSES[$i]}"; req="${DIAG_REQUIRED[$i]}"
    case "$st" in
      pass) DIAG_PASSED=$((DIAG_PASSED + 1)) ;;
      warn) DIAG_WARNINGS=$((DIAG_WARNINGS + 1)); [ "$DIAG_OVERALL" = pass ] && DIAG_OVERALL="warn" ;;
      fail)
        DIAG_FAILED=$((DIAG_FAILED + 1))
        if [ "$req" = true ]; then DIAG_OVERALL="fail"
        elif [ "$DIAG_OVERALL" = pass ]; then DIAG_OVERALL="warn"
        fi
        ;;
      skip)
        DIAG_SKIPPED=$((DIAG_SKIPPED + 1))
        [ "$req" != true ] || [ "$DIAG_OVERALL" != pass ] || DIAG_OVERALL="warn"
        ;;
    esac
  done
  return 0
}

diag_print_json() {
  diag_counts
  local i comma="" profile_json="null"
  [ -z "$DIAG_PROFILE" ] || profile_json="\"$(json_escape "$DIAG_PROFILE")\""
  printf '{"schema_version":1,"command":"%s","profile":%s,"status":"%s",' \
    "$(json_escape "$DIAG_COMMAND")" "$profile_json" "$DIAG_OVERALL"
  printf '"summary":{"passed":%d,"warnings":%d,"failed":%d,"skipped":%d},' \
    "$DIAG_PASSED" "$DIAG_WARNINGS" "$DIAG_FAILED" "$DIAG_SKIPPED"
  printf '"checks":['
  for ((i = 0; i < ${#DIAG_IDS[@]}; i++)); do
    printf '%s{"id":"%s","label":"%s","status":"%s","message":"%s","required":%s}' \
      "$comma" "$(json_escape "${DIAG_IDS[$i]}")" "$(json_escape "${DIAG_LABELS[$i]}")" \
      "${DIAG_STATUSES[$i]}" "$(json_escape "${DIAG_MESSAGES[$i]}")" "${DIAG_REQUIRED[$i]}"
    comma=,
  done
  printf '],"capabilities":{"basic":"%s","streaming":"%s","tools":"%s"}}\n' \
    "$DIAG_CAP_BASIC" "$DIAG_CAP_STREAMING" "$DIAG_CAP_TOOLS"
}

diag_print_human() {
  diag_counts
  local title="$DIAG_COMMAND" i mark
  [ -z "$DIAG_PROFILE" ] || title="$title: $DIAG_PROFILE"
  printf 'CCX %s\n' "$title"
  for ((i = 0; i < ${#DIAG_IDS[@]}; i++)); do
    case "${DIAG_STATUSES[$i]}" in
      pass) mark=PASS ;;
      warn) mark=WARN ;;
      fail) mark=FAIL ;;
      skip) mark=SKIP ;;
    esac
    printf '  %-4s %-22s %s\n' "$mark" "${DIAG_LABELS[$i]}" "${DIAG_MESSAGES[$i]}"
  done
  printf '\nCapabilities: basic=%s, streaming=%s, tools=%s\n' \
    "$DIAG_CAP_BASIC" "$DIAG_CAP_STREAMING" "$DIAG_CAP_TOOLS"
  printf 'Summary: %d passed, %d warnings, %d failed, %d skipped (%s)\n' \
    "$DIAG_PASSED" "$DIAG_WARNINGS" "$DIAG_FAILED" "$DIAG_SKIPPED" "$DIAG_OVERALL"
}

diag_finish() { # json(true|false)
  local json="$1"
  if [ "$json" = true ]; then diag_print_json; else diag_print_human; fi
  [ "$DIAG_OVERALL" != fail ]
}

is_loopback_url() {
  local authority="${1#*://}" host port
  authority="${authority%%/*}"; authority="${authority%%\?*}"; authority="${authority%%\#*}"
  case "$authority" in
    localhost | \[::1\]) return 0 ;;
    localhost:*) port="${authority#localhost:}" ;;
    \[::1\]:*) port="${authority#\[::1\]:}" ;;
  esac
  if [ -n "${port:-}" ]; then case "$port" in *[!0-9]*) return 1 ;; *) return 0 ;; esac; fi
  host="${authority%%:*}"
  case "$host" in
    127.*)
      case "$host" in *[!0-9.]*) return 1 ;; esac
      [ "$(printf '%s' "$host" | awk -F. 'NF==4 && $1==127 && $2>=0 && $2<=255 && $3>=0 && $3<=255 && $4>=0 && $4<=255 {print "yes"}')" = yes ]
      ;;
    *) return 1 ;;
  esac
}

valid_ipv4_address() {
  local host="$1"
  [ "$(printf '%s' "$host" | awk -F. '
    NF == 4 {
      for (i = 1; i <= 4; i++) {
        if ($i !~ /^[0-9]+$/ || $i < 0 || $i > 255) exit
      }
      print "yes"
    }
  ')" = yes ]
}

valid_ipv6_literal() {
  local value="$1" left right compressed=false part groups_count=0 i
  local -a left_groups=() right_groups=() groups=()
  if [[ "$value" == *::* ]]; then
    left="${value%%::*}"
    right="${value#*::}"
    [[ "$right" != *::* ]] || return 1
    compressed=true
  else
    left="$value"
    right=""
    case "$value" in :* | *:) return 1 ;; esac
  fi
  [ -z "$left" ] || IFS=':' read -r -a left_groups <<< "$left"
  if [ "$compressed" = true ]; then
    [ -z "$right" ] || IFS=':' read -r -a right_groups <<< "$right"
  fi
  groups=("${left_groups[@]}" "${right_groups[@]}")
  for ((i = 0; i < ${#groups[@]}; i++)); do
    part="${groups[$i]}"
    [ -n "$part" ] || return 1
    if [[ "$part" == *.* ]]; then
      [ "$i" -eq $((${#groups[@]} - 1)) ] || return 1
      valid_ipv4_address "$part" || return 1
      groups_count=$((groups_count + 2))
    else
      [[ "$part" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      groups_count=$((groups_count + 1))
    fi
  done
  if [ "$compressed" = true ]; then
    [ "$groups_count" -lt 8 ]
  else
    [ "$groups_count" -eq 8 ]
  fi
}

valid_endpoint_authority() {
  local authority="$1" host="" port="" prefix rest label
  local -a labels=()
  if [[ "$authority" == \[* ]]; then
    prefix="${authority%%]*}"
    [ "$prefix" != "$authority" ] || return 1
    host="${prefix#\[}"
    rest="${authority:$(( ${#prefix} + 1 ))}"
    valid_ipv6_literal "$host" || return 1
    if [ -n "$rest" ]; then
      case "$rest" in :*) port="${rest#:}" ;; *) return 1 ;; esac
    fi
  else
    case "$authority" in
      *:*)
        host="${authority%:*}"
        port="${authority##*:}"
        case "$host" in *:*) return 1 ;; esac
        ;;
      *) host="$authority" ;;
    esac
    [ -n "$host" ] || return 1
    case "$host" in
      *[!0-9.]*)
        host="${host%.}"
        [ -n "$host" ] || return 1
        case "$host" in .* | *..* | *[!A-Za-z0-9.-]*) return 1 ;; esac
        IFS='.' read -r -a labels <<< "$host"
        for label in "${labels[@]}"; do
          [ -n "$label" ] && [ "${#label}" -le 63 ] || return 1
          case "$label" in -* | *-) return 1 ;; esac
        done
        ;;
      *) valid_ipv4_address "$host" || return 1 ;;
    esac
  fi
  if [ -n "$port" ]; then
    case "$port" in *[!0-9]* | '') return 1 ;; esac
    [ "${#port}" -le 5 ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
  elif [[ "$authority" == *: ]]; then
    return 1
  fi
  return 0
}

validate_endpoint_url() { # 0 valid, 1 invalid, 2 insecure remote HTTP, 3 embedded credentials
  local url="$1" authority
  case "$url" in http://* | https://*) ;; *) return 1 ;; esac
  case "$url" in *[[:space:]]* | *'?'* | *'#'* | *'\'*) return 1 ;; esac
  authority="${url#*://}"; authority="${authority%%/*}"
  [ -n "$authority" ] || return 1
  case "$authority" in *@*) return 3 ;; esac
  valid_endpoint_authority "$authority" || return 1
  case "$url" in http://*) is_loopback_url "$url" || return 2 ;; esac
  return 0
}

require_single_line() { # label value [allow-empty]
  local label="$1" value="$2" allow_empty="${3:-false}"
  case "$value" in *$'\n'* | *$'\r'*) die "$label must be a single-line value" ;; esac
  if [ "$allow_empty" != true ] && [ -z "$value" ]; then die "$label must not be empty"; fi
}

require_endpoint_url() { # label value; never echo the potentially secret URL
  local label="$1" value="$2" rc=0
  validate_endpoint_url "$value" || rc=$?
  case "$rc" in
    0) return 0 ;;
    2) die "$label: remote endpoints must use HTTPS" ;;
    3) die "$label: credentials must not be embedded in the URL" ;;
    *) die "$label: expected a valid HTTP or HTTPS URL without whitespace, query, or fragment" ;;
  esac
}

csv_entry_count() { # empty string -> 0; otherwise preserve empty positional entries
  local value="$1"
  if [ -z "$value" ]; then printf '0'; else awk -F, '{print NF}' <<< "$value"; fi
}

validate_fallback_config() { # urls keys
  local urls="$1" keys="$2" url url_count key_count
  require_single_line 'fallback URLs' "$urls" true
  require_single_line 'fallback keys' "$keys" true
  if [ -z "$urls" ]; then
    [ -z "$keys" ] || die 'fallback keys require at least one fallback URL'
    return 0
  fi
  case "$urls" in ,* | *, | *,,*) die 'fallback URLs cannot contain empty entries' ;; esac
  local -a entries=()
  IFS=',' read -r -a entries <<< "$urls"
  for url in "${entries[@]}"; do require_endpoint_url 'fallback URL' "$url"; done
  url_count="${#entries[@]}"
  key_count="$(csv_entry_count "$keys")"
  [ "$key_count" -le "$url_count" ] || die 'more fallback keys than fallback URLs are configured'
}

# Pinning is stored positionally: `;` separates upstreams (position 0 is the
# primary), `,` separates slugs within one upstream. A comma cannot separate
# positions the way it does for fallback keys, because each position is itself
# a list.
validate_provider_pinning() { # label value max_positions
  local label="$1" value="$2" max="$3" position slug count
  [ -n "$value" ] || return 0
  require_single_line "$label" "$value" true
  local -a positions=()
  IFS=';' read -r -a positions <<< "$value"
  count="${#positions[@]}"
  [ "$count" -le "$max" ] \
    || die "$label has more positions ($count) than configured upstreams ($max)"
  for position in "${positions[@]}"; do
    [ -n "$position" ] || continue
    local -a slugs=()
    IFS=',' read -r -a slugs <<< "$position"
    for slug in "${slugs[@]}"; do
      [ -n "$slug" ] || continue
      printf '%s' "$slug" | grep -qE '^[A-Za-z0-9._-]+$' \
        || die "$label has an invalid provider slug: $slug"
    done
  done
}

validate_require_parameters() { # label value max_positions
  local label="$1" value="$2" max="$3" position count
  [ -n "$value" ] || return 0
  require_single_line "$label" "$value" true
  local -a positions=()
  IFS=';' read -r -a positions <<< "$value"
  count="${#positions[@]}"
  [ "$count" -le "$max" ] \
    || die "$label has more positions ($count) than configured upstreams ($max)"
  for position in "${positions[@]}"; do
    case "$position" in '' | 1 | true) ;; *) die "$label entries must be 1, true, or empty" ;; esac
  done
}

# Fold a primary position and the positional fallback entries into the single
# `;`-separated value the router parses.
join_pinning() { # primary fallbacks
  if [ -n "$2" ]; then printf '%s;%s' "$1" "$2"; else printf '%s' "$1"; fi
}

profile_syntax_valid() {
  local file="$1" line key seen=" "
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | '#'* ) continue ;; esac
    case "$line" in *$'\r'*) return 1 ;; esac
    case "$line" in *=*) ;; *) return 1 ;; esac
    key="${line%%=*}"
    printf '%s' "$key" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$' || return 1
    case "$seen" in *" $key "*) return 1 ;; esac
    seen="$seen$key "
  done < "$file"
  return 0
}

file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null; }

# Result globals populated by http_request. Authentication is streamed to curl
# over stdin so credentials never appear in argv, output, or a temporary file.
HTTP_STATUS=""; HTTP_BODY=""; HTTP_OK=false
http_request() { # method url auth(none|bearer|apikey) token payload accept
  local method="$1" url="$2" auth="$3" token="$4" payload="$5" accept="$6"
  local body_file status="" rc=0 secret_header=""
  local -a args=()
  HTTP_STATUS="000"; HTTP_BODY=""; HTTP_OK=false
  body_file="$(mktemp "${TMPDIR:-/tmp}/ccx-http-body.XXXXXX")" || return 1
  chmod 600 "$body_file"
  if [ "$auth" != none ] && [ -n "$token" ]; then
    case "$auth" in
      bearer) secret_header="Authorization: Bearer $token" ;;
      apikey) secret_header="x-api-key: $token" ;;
    esac
    args+=(--header @-)
  fi
  args+=(--header 'Content-Type: application/json' --header "Accept: $accept")
  if [ "$method" = POST ]; then args+=(--data-binary "$payload"); fi
  if [ -n "$secret_header" ]; then
    status="$(printf '%s\n' "$secret_header" | "$CCX_CURL_BIN" --silent --proto '=http,https' \
      --connect-timeout 4 --max-time 20 --max-filesize 1048576 --request "$method" \
      --output "$body_file" --write-out '%{http_code}' "${args[@]}" "$url" 2>/dev/null)" || rc=$?
  else
    status="$("$CCX_CURL_BIN" --silent --proto '=http,https' --connect-timeout 4 --max-time 20 \
      --max-filesize 1048576 --request "$method" --output "$body_file" \
      --write-out '%{http_code}' "${args[@]}" "$url" 2>/dev/null)" || rc=$?
  fi
  HTTP_BODY="$(head -c 1048576 "$body_file" | LC_ALL=C tr -d '\000')"
  rm -f -- "$body_file"
  case "$status" in [0-9][0-9][0-9]) HTTP_STATUS="$status" ;; *) HTTP_STATUS="000" ;; esac
  if [ "$rc" -eq 0 ] && [ "$HTTP_STATUS" != 000 ]; then HTTP_OK=true; return 0; fi
  return 1
}

json_parser_available() {
  command -v python3 >/dev/null 2>&1 || command -v node >/dev/null 2>&1
}

probe_shape_valid() { # capability protocol; reads HTTP_BODY without echoing it
  local capability="$1" protocol="$2"
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$HTTP_BODY" | python3 -c '
import json,re,sys
cap, protocol = sys.argv[1], sys.argv[2]
raw = sys.stdin.read()
def ordinary():
    try: value = json.loads(raw)
    except Exception: return False
    if not isinstance(value, dict) or value.get("type") == "error" or "error" in value:
        return False
    if cap == "basic":
        if protocol == "anthropic":
            return value.get("type") == "message" and isinstance(value.get("content"), list)
        choices = value.get("choices")
        return isinstance(choices, list) and bool(choices) and isinstance(choices[0].get("message"), dict)
    if protocol == "anthropic":
        return any(isinstance(block, dict) and block.get("type") == "tool_use" and block.get("name") == "ccx_probe" for block in value.get("content", []))
    return any(call.get("function", {}).get("name") == "ccx_probe" for choice in value.get("choices", []) if isinstance(choice, dict) for call in choice.get("message", {}).get("tool_calls", []) if isinstance(call, dict))
def streaming():
    normalized = raw.replace("\r\n", "\n").replace("\r", "\n")
    names, payloads = [], []
    for block in re.split(r"\n\n+", normalized):
        data = []
        for line in block.split("\n"):
            if line.startswith("event:"): names.append(line[6:].strip())
            elif line.startswith("data:"): data.append(line[5:].lstrip())
        joined = "\n".join(data)
        if joined and joined != "[DONE]":
            try: payloads.append(json.loads(joined))
            except Exception: pass
    if any(isinstance(v, dict) and (v.get("type") == "error" or "error" in v) for v in payloads):
        return False
    if protocol == "anthropic":
        valid = {"message_start","content_block_start","content_block_delta","content_block_stop","message_delta","message_stop"}
        return any(name in valid for name in names) or any(isinstance(v, dict) and v.get("type") in valid for v in payloads)
    return any(isinstance(choice.get("delta"), dict) for v in payloads if isinstance(v, dict) for choice in v.get("choices", []) if isinstance(choice, dict))
ok = streaming() if cap == "streaming" else ordinary()
sys.exit(0 if ok else 1)
' "$capability" "$protocol" >/dev/null 2>&1
    return
  fi
  if command -v node >/dev/null 2>&1; then
    printf '%s' "$HTTP_BODY" | node -e '
const [cap, protocol] = process.argv.slice(1);
let raw = ""; process.stdin.setEncoding("utf8"); process.stdin.on("data", c => raw += c);
process.stdin.on("end", () => {
  const safe = s => { try { return JSON.parse(s); } catch { return null; } };
  let ok = false;
  if (cap !== "streaming") {
    const v = safe(raw);
    if (v && typeof v === "object" && v.type !== "error" && !("error" in v)) {
      if (cap === "basic") ok = protocol === "anthropic"
        ? v.type === "message" && Array.isArray(v.content)
        : Array.isArray(v.choices) && v.choices.length > 0 && typeof v.choices[0]?.message === "object";
      else ok = protocol === "anthropic"
        ? (v.content || []).some(b => b?.type === "tool_use" && b?.name === "ccx_probe")
        : (v.choices || []).some(c => (c?.message?.tool_calls || []).some(t => t?.function?.name === "ccx_probe"));
    }
  } else {
    const names = [], values = [];
    for (const block of raw.replace(/\r\n?/g, "\n").split(/\n\n+/)) {
      const data = [];
      for (const line of block.split("\n")) {
        if (line.startsWith("event:")) names.push(line.slice(6).trim());
        if (line.startsWith("data:")) data.push(line.slice(5).trimStart());
      }
      const joined = data.join("\n"); const parsed = joined && joined !== "[DONE]" ? safe(joined) : null;
      if (parsed) values.push(parsed);
    }
    const bad = values.some(v => v?.type === "error" || (v && "error" in v));
    if (!bad && protocol === "anthropic") {
      const valid = new Set(["message_start","content_block_start","content_block_delta","content_block_stop","message_delta","message_stop"]);
      ok = names.some(n => valid.has(n)) || values.some(v => valid.has(v?.type));
    } else if (!bad) ok = values.some(v => (v?.choices || []).some(c => c?.delta && typeof c.delta === "object"));
  }
  process.exit(ok ? 0 : 1);
});
' "$capability" "$protocol" >/dev/null 2>&1
    return
  fi
  return 2
}

profile_diagnostics() { # profile network(true|false); sets PROFILE_* globals
  local name="$1" network="$2" penv mode syntax=true url_rc models_url auth_kind token \
        fallback_urls fallback_keys router_attempts fallback_count key_count fallback_valid \
        pin_only pin_order pin_require pin_max pin_summary pin_status pin_hosts
  PROFILE_READY=false; PROFILE_PROVIDER=""; PROFILE_ROUTER=""; PROFILE_URL=""
  PROFILE_TOKEN=""; PROFILE_AUTH_KIND=none; PROFILE_MODEL=""; PROFILE_PROTOCOL=""

  if ! valid_profile_name "$name"; then
    diag_add profile.name 'Profile name' fail 'Profile name is invalid.' true
    return
  fi
  penv="$(profile_env "$name")"
  if [ ! -f "$penv" ]; then
    diag_add profile.exists 'Profile' fail 'Profile was not found.' true
    return
  fi
  diag_add profile.exists 'Profile' pass 'Profile file was found.' true

  mode="$(file_mode "$penv")"
  if [ "$mode" = 600 ]; then
    diag_add profile.permissions 'File permissions' pass 'Profile file is private (0600).' true
  else
    diag_add profile.permissions 'File permissions' fail 'Profile file must have mode 0600.' true
  fi

  profile_syntax_valid "$penv" || syntax=false
  if [ "$syntax" = true ]; then
    diag_add profile.syntax 'Profile syntax' pass 'Profile syntax is valid and keys are unique.' true
  else
    diag_add profile.syntax 'Profile syntax' fail 'Profile has a malformed line, duplicate key, or invalid key.' true
    return
  fi

  PROFILE_PROVIDER="$(kv_get "$penv" CCX_PROVIDER)"
  PROFILE_ROUTER="$(kv_get "$penv" CCX_ROUTER)"
  PROFILE_MODEL="$(kv_get "$penv" ANTHROPIC_MODEL)"
  local isolate; isolate="$(kv_get "$penv" CCX_ISOLATE)"
  if [ -n "$PROFILE_PROVIDER" ]; then
    diag_add profile.provider 'Provider' pass 'Provider is configured.' true
  else
    diag_add profile.provider 'Provider' fail 'CCX_PROVIDER is missing.' true
  fi
  if [ -n "$PROFILE_MODEL" ]; then
    diag_add profile.model 'Model' pass 'A default model is configured.' true
  else
    diag_add profile.model 'Model' fail 'ANTHROPIC_MODEL is missing.' true
  fi
  case "$isolate" in
    true)
      local home hmode; home="$(profile_dir "$name")/home"
      if [ ! -d "$home" ]; then
        diag_add profile.isolation 'Isolation' warn 'Isolated config directory is missing; launch will create it.' false
      else
        hmode="$(file_mode "$home")"
        if [ "$hmode" = 700 ]; then
          diag_add profile.isolation 'Isolation' pass 'Isolated config directory is private (0700).' false
        else
          diag_add profile.isolation 'Isolation' warn 'Isolated config directory should have mode 0700.' false
        fi
      fi
      ;;
    false) diag_add profile.isolation 'Isolation' pass 'Profile intentionally uses the default Claude config.' false ;;
    *) diag_add profile.isolation 'Isolation' fail 'CCX_ISOLATE must be true or false.' true ;;
  esac

  if [ -n "$PROFILE_ROUTER" ]; then
    PROFILE_PROTOCOL=openai
    PROFILE_URL="$(kv_get "$penv" CCX_UPSTREAM_BASE_URL)"
    PROFILE_TOKEN="$(kv_get "$penv" CCX_UPSTREAM_API_KEY)"
    [ -z "$PROFILE_TOKEN" ] || PROFILE_AUTH_KIND=bearer
    if resolve_router_bin >/dev/null 2>&1; then
      diag_add system.router_binary 'Router binary' pass 'ccx-router is available.' true
    else
      diag_add system.router_binary 'Router binary' fail 'ccx-router is not available.' true
    fi
    fallback_urls="$(kv_get "$penv" CCX_ROUTER_FALLBACK_URLS)"
    fallback_keys="$(kv_get "$penv" CCX_ROUTER_FALLBACK_KEYS)"
    router_attempts="$(kv_get "$penv" CCX_ROUTER_ATTEMPTS_PER_UPSTREAM)"
    if [ -n "$fallback_urls" ]; then
      local -a fallback_list=()
      fallback_count="$(csv_entry_count "$fallback_urls")"; fallback_valid=true
      case "$fallback_urls" in ,* | *, | *,,*) fallback_valid=false ;; esac
      [ "$fallback_valid" != true ] || IFS=',' read -r -a fallback_list <<< "$fallback_urls"
      local fallback_url
      for fallback_url in "${fallback_list[@]}"; do
        if ! validate_endpoint_url "$fallback_url"; then fallback_valid=false; break; fi
      done
      if [ "$fallback_valid" = true ]; then
        diag_add router.fallbacks 'Ordered fallbacks' pass "$fallback_count fallback endpoint(s) are configured." false
      else
        diag_add router.fallbacks 'Ordered fallbacks' fail 'A fallback endpoint has an invalid or insecure URL.' true
      fi
      if [ -n "$fallback_keys" ]; then
        key_count="$(csv_entry_count "$fallback_keys")"
        if [ "$key_count" -le "$fallback_count" ]; then
          diag_add router.fallback_credentials 'Fallback credentials' pass "$key_count positional fallback credential slot(s) are present; empty slots send no Authorization header." false
        else
          diag_add router.fallback_credentials 'Fallback credentials' fail 'More fallback credentials than endpoints are configured.' true
        fi
      fi
    else
      diag_add router.fallbacks 'Ordered fallbacks' pass 'No fallback endpoint is configured.' false
      [ -z "$fallback_keys" ] || diag_add router.fallback_credentials 'Fallback credentials' fail 'Fallback credentials require fallback endpoints.' true
    fi
    if [ -z "$router_attempts" ]; then
      diag_add router.retry_policy 'Retry policy' pass 'Each upstream is attempted once.' false
    elif [[ "$router_attempts" =~ ^[0-9]+$ ]] && [ "$router_attempts" -ge 1 ] && [ "$router_attempts" -le 10 ]; then
      diag_add router.retry_policy 'Retry policy' pass "$router_attempts attempt(s) per upstream are configured." false
    else
      diag_add router.retry_policy 'Retry policy' fail 'Attempts per upstream must be between 1 and 10.' true
    fi
    pin_only="$(kv_get "$penv" CCX_ROUTER_PROVIDER_ONLY)"
    pin_order="$(kv_get "$penv" CCX_ROUTER_PROVIDER_ORDER)"
    pin_require="$(kv_get "$penv" CCX_ROUTER_REQUIRE_PARAMETERS)"
    if [ -z "$pin_only$pin_order$pin_require" ]; then
      diag_add router.provider_pinning 'Provider pinning' pass 'No provider pinning is configured.' false
    else
      pin_max=1
      [ -z "$fallback_urls" ] || pin_max=$((1 + $(csv_entry_count "$fallback_urls")))
      pin_status=pass
      pin_summary=""
      [ -z "$pin_only" ] || pin_summary="only=$pin_only"
      [ -z "$pin_order" ] || pin_summary="${pin_summary:+$pin_summary, }order=$pin_order"
      [ -z "$pin_require" ] || pin_summary="${pin_summary:+$pin_summary, }require_parameters=$pin_require"
      # Positions beyond the chain would be rejected at launch, so surface it here.
      local pin_value pin_count
      for pin_value in "$pin_only" "$pin_order" "$pin_require"; do
        [ -n "$pin_value" ] || continue
        pin_count="$(printf '%s' "$pin_value" | awk -F';' '{print NF}')"
        [ "$pin_count" -le "$pin_max" ] || pin_status=fail
      done
      if [ "$pin_status" = fail ]; then
        diag_add router.provider_pinning 'Provider pinning' fail \
          "Pinning describes more upstreams than the $pin_max configured ($pin_summary)." true
      else
        # `provider` is an OpenRouter field. A proxy in front of it is
        # legitimate, so an unrecognised host is a warning, never a failure.
        pin_hosts="$PROFILE_URL,$fallback_urls"
        if printf '%s' "$pin_hosts" | grep -q 'openrouter\.ai'; then
          diag_add router.provider_pinning 'Provider pinning' pass \
            "Provider pinning is configured ($pin_summary)." false
        else
          diag_add router.provider_pinning 'Provider pinning' warn \
            "Provider pinning is configured ($pin_summary) but no upstream is openrouter.ai; the provider field is ignored unless the endpoint proxies OpenRouter." false
        fi
      fi
    fi
  else
    PROFILE_PROTOCOL=anthropic
    PROFILE_URL="$(kv_get "$penv" ANTHROPIC_BASE_URL)"
    PROFILE_TOKEN="$(kv_get "$penv" ANTHROPIC_API_KEY)"
    if [ -n "$PROFILE_TOKEN" ]; then PROFILE_AUTH_KIND=apikey
    else
      PROFILE_TOKEN="$(kv_get "$penv" ANTHROPIC_AUTH_TOKEN)"
      [ -z "$PROFILE_TOKEN" ] || PROFILE_AUTH_KIND=bearer
    fi
  fi

  if [ -z "$PROFILE_URL" ]; then
    if [ -z "$PROFILE_ROUTER" ] && [ "$PROFILE_PROVIDER" = claude ]; then
      diag_add profile.endpoint 'Endpoint' pass 'Claude first-party login will provide the endpoint.' true
      diag_add profile.credential 'Credential' pass 'Claude first-party login manages authentication.' true
      case "$network" in
        false) diag_add endpoint.reachable 'Endpoint reachability' skip 'No explicit endpoint to probe safely.' false ;;
        omit) : ;;
        *) diag_add endpoint.reachable 'Endpoint reachability' skip 'No explicit endpoint to probe safely.' false ;;
      esac
    else
      diag_add profile.endpoint 'Endpoint' fail 'Provider endpoint is missing.' true
      diag_add profile.credential 'Credential' skip 'Credential check skipped because endpoint is missing.' false
    fi
    return
  fi

  url_rc=0; validate_endpoint_url "$PROFILE_URL" || url_rc=$?
  case "$url_rc" in
    0) diag_add profile.endpoint 'Endpoint' pass 'Endpoint uses an allowed URL form.' true ;;
    1) diag_add profile.endpoint 'Endpoint' fail 'Endpoint must be an HTTP or HTTPS URL.' true; return ;;
    2) diag_add profile.endpoint 'Endpoint' fail 'Remote endpoints must use HTTPS.' true; return ;;
    3) diag_add profile.endpoint 'Endpoint' fail 'Credentials must not be embedded in the endpoint URL.' true; return ;;
  esac

  if [ -n "$PROFILE_TOKEN" ]; then
    case "$PROFILE_TOKEN" in *$'\r'* | *$'\n'*) diag_add profile.credential 'Credential' fail 'Credential contains an invalid line break.' true; return ;; esac
    diag_add profile.credential 'Credential' pass 'A credential is configured (value hidden).' true
  elif is_loopback_url "$PROFILE_URL"; then
    diag_add profile.credential 'Credential' pass 'Local endpoint does not require a stored credential.' true
  else
    diag_add profile.credential 'Credential' fail 'Remote endpoint has no configured credential.' true
  fi

  PROFILE_READY=true
  if [ "$network" = omit ]; then
    return
  elif [ "$network" = false ]; then
    diag_add endpoint.reachable 'Endpoint reachability' skip 'Network checks were disabled.' false
    return
  fi
  if ! command -v "$CCX_CURL_BIN" >/dev/null 2>&1; then
    diag_add system.curl 'HTTP client' fail 'curl is required for network diagnostics.' true
    return
  fi
  diag_add system.curl 'HTTP client' pass 'curl is available.' true
  if [ "$PROFILE_PROTOCOL" = openai ]; then models_url="${PROFILE_URL%/}/models"
  else models_url="${PROFILE_URL%/}/v1/models"; fi
  auth_kind="$PROFILE_AUTH_KIND"; token="$PROFILE_TOKEN"
  if http_request GET "$models_url" "$auth_kind" "$token" '' 'application/json'; then
    case "$HTTP_STATUS" in
      2??) diag_add endpoint.reachable 'Endpoint reachability' pass 'Endpoint accepted an authenticated model-list request.' true ;;
      401 | 403) diag_add endpoint.reachable 'Endpoint reachability' fail 'Endpoint rejected the configured credential.' true ;;
      404 | 405) diag_add endpoint.reachable 'Endpoint reachability' warn 'Endpoint is reachable but does not expose model discovery.' false ;;
      429) diag_add endpoint.reachable 'Endpoint reachability' warn 'Endpoint is reachable but currently rate-limited.' false ;;
      *) diag_add endpoint.reachable 'Endpoint reachability' fail "Endpoint returned HTTP $HTTP_STATUS." true ;;
    esac
  else
    diag_add endpoint.reachable 'Endpoint reachability' fail 'Endpoint connection failed or timed out.' true
  fi
}

common_system_diagnostics() {
  if [ -d "$CCX_HOME" ]; then
    diag_add system.config_dir 'Config directory' pass 'CCX configuration directory exists.' false
  else
    diag_add system.config_dir 'Config directory' warn 'CCX configuration directory does not exist yet.' false
  fi
  if command -v "$CCX_CLAUDE_BIN" >/dev/null 2>&1; then
    diag_add system.claude_binary 'Claude binary' pass 'Claude Code is available.' true
  else
    diag_add system.claude_binary 'Claude binary' fail 'Claude Code is not available.' true
  fi
}

cmd_doctor() {
  local name="" json=false network=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true; shift ;;
      --no-network) network=false; shift ;;
      -h | --help)
        printf 'Usage: ccx doctor [profile] [--json] [--no-network]\n'
        return 0
        ;;
      --*) die "doctor: unknown option: $1" ;;
      *) [ -z "$name" ] || die 'doctor: only one profile may be specified'; name="$1"; shift ;;
    esac
  done
  diag_reset doctor "$name"
  common_system_diagnostics
  if [ -n "$name" ]; then
    profile_diagnostics "$name" "$network"
  else
    local count=0 d
    if [ -d "$(profiles_dir)" ]; then
      for d in "$(profiles_dir)"/*/profile.env; do [ -f "$d" ] && count=$((count + 1)); done
    fi
    if [ "$count" -gt 0 ]; then
      diag_add profiles.available 'Profiles' pass "$count profile(s) are available; pass a profile name for full checks." false
    else
      diag_add profiles.available 'Profiles' warn 'No profiles are available yet.' false
    fi
  fi
  diag_finish "$json"
}

certify_add_skipped() { # check ids not selected or blocked
  local cap="$1" message="$2" required="$3"
  case "$cap" in
    basic) DIAG_CAP_BASIC=skip; diag_add capability.basic 'Basic response' skip "$message" "$required" ;;
    streaming) DIAG_CAP_STREAMING=skip; diag_add capability.streaming 'Streaming' skip "$message" "$required" ;;
    tools) DIAG_CAP_TOOLS=skip; diag_add capability.tools 'Tool calls' skip "$message" "$required" ;;
  esac
}

certify_skip_remaining() { # reason for selected capabilities
  local reason="$1" part required
  for part in basic streaming tools; do
    case "$selected" in
      *",$part,"*) certify_add_skipped "$part" "$reason" true ;;
      *) certify_add_skipped "$part" "Capability was not selected." false ;;
    esac
  done
}

certify_probe() { # capability; adds a check and sets capability state
  local cap="$1" endpoint payload accept='application/json' required=true
  local model; model="$(json_escape "$PROFILE_MODEL")"
  if [ "$PROFILE_PROTOCOL" = anthropic ]; then
    endpoint="${PROFILE_URL%/}/v1/messages"
    case "$cap" in
      basic) payload="{\"model\":\"$model\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with OK.\"}]}" ;;
      streaming) payload="{\"model\":\"$model\",\"max_tokens\":1,\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with OK.\"}]}"; accept='text/event-stream' ;;
      tools) payload="{\"model\":\"$model\",\"max_tokens\":32,\"messages\":[{\"role\":\"user\",\"content\":\"Call ccx_probe exactly once.\"}],\"tools\":[{\"name\":\"ccx_probe\",\"description\":\"Inert compatibility probe; performs no action.\",\"input_schema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}}],\"tool_choice\":{\"type\":\"tool\",\"name\":\"ccx_probe\"}}" ;;
    esac
  else
    endpoint="${PROFILE_URL%/}/chat/completions"
    case "$cap" in
      basic) payload="{\"model\":\"$model\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with OK.\"}]}" ;;
      streaming) payload="{\"model\":\"$model\",\"max_tokens\":1,\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"Reply with OK.\"}]}"; accept='text/event-stream' ;;
      tools) payload="{\"model\":\"$model\",\"max_tokens\":32,\"messages\":[{\"role\":\"user\",\"content\":\"Call ccx_probe exactly once.\"}],\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"ccx_probe\",\"description\":\"Inert compatibility probe; performs no action.\",\"parameters\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}}}],\"tool_choice\":{\"type\":\"function\",\"function\":{\"name\":\"ccx_probe\"}}}" ;;
    esac
  fi

  if ! http_request POST "$endpoint" "$PROFILE_AUTH_KIND" "$PROFILE_TOKEN" "$payload" "$accept"; then
    case "$cap" in
      basic) DIAG_CAP_BASIC=fail; diag_add capability.basic 'Basic response' fail 'Probe connection failed or timed out.' true ;;
      streaming) DIAG_CAP_STREAMING=fail; diag_add capability.streaming 'Streaming' fail 'Probe connection failed or timed out.' "$required" ;;
      tools) DIAG_CAP_TOOLS=fail; diag_add capability.tools 'Tool calls' fail 'Probe connection failed or timed out.' "$required" ;;
    esac
    return
  fi
  if [[ "$HTTP_STATUS" != 2?? ]]; then
    local msg="Probe was rejected with HTTP $HTTP_STATUS."
    case "$cap" in
      basic) DIAG_CAP_BASIC=fail; diag_add capability.basic 'Basic response' fail "$msg" true ;;
      streaming) DIAG_CAP_STREAMING=fail; diag_add capability.streaming 'Streaming' fail "$msg" "$required" ;;
      tools) DIAG_CAP_TOOLS=fail; diag_add capability.tools 'Tool calls' fail "$msg" "$required" ;;
    esac
    return
  fi

  case "$cap" in
    basic)
      if probe_shape_valid basic "$PROFILE_PROTOCOL"; then
        DIAG_CAP_BASIC=pass; diag_add capability.basic 'Basic response' pass 'Provider returned a recognized response.' true
      else
        DIAG_CAP_BASIC=fail; diag_add capability.basic 'Basic response' fail 'Provider returned an unrecognized response shape.' true
      fi
      ;;
    streaming)
      if probe_shape_valid streaming "$PROFILE_PROTOCOL"; then
        DIAG_CAP_STREAMING=pass; diag_add capability.streaming 'Streaming' pass 'Provider returned a valid event stream.' "$required"
      else
        DIAG_CAP_STREAMING=fail; diag_add capability.streaming 'Streaming' fail 'Provider did not return valid stream events.' "$required"
      fi
      ;;
    tools)
      if probe_shape_valid tools "$PROFILE_PROTOCOL"; then
        DIAG_CAP_TOOLS=pass; diag_add capability.tools 'Tool calls' pass 'Provider returned the inert tool call.' "$required"
      else
        DIAG_CAP_TOOLS=fail; diag_add capability.tools 'Tool calls' fail 'Provider did not return the requested inert tool call.' "$required"
      fi
      ;;
  esac
}

cmd_certify() {
  local name="" json=false yes=false checks='basic,streaming,tools' selected="" ans=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=true; shift ;;
      --yes | -y) yes=true; shift ;;
      --checks) [ $# -ge 2 ] || die 'certify: --checks requires a value'; checks="$2"; shift 2 ;;
      -h | --help)
        printf 'Usage: ccx certify <profile> [--checks basic,streaming,tools] [--yes] [--json]\n'
        return 0
        ;;
      --*) die "certify: unknown option: $1" ;;
      *) [ -z "$name" ] || die 'certify: only one profile may be specified'; name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || die 'certify: profile name required'
  [ -n "$checks" ] || die 'certify: --checks cannot be empty'
  case ",$checks," in
    *,all,*) checks='basic,streaming,tools' ;;
  esac
  local part rest="$checks"
  while [ -n "$rest" ]; do
    part="${rest%%,*}"; if [ "$rest" = "$part" ]; then rest=""; else rest="${rest#*,}"; fi
    case "$part" in basic | streaming | tools) selected="$selected,$part," ;; *) die "certify: unknown check: $part" ;; esac
  done

  diag_reset certify "$name"
  common_system_diagnostics
  profile_diagnostics "$name" omit
  if [ -n "$PROFILE_ROUTER" ]; then
    diag_add certify.scope 'Certification scope' pass 'Probes target the OpenAI-compatible upstream; router translation is covered by router conformance tests.' false
  elif [ -n "$PROFILE_URL" ]; then
    diag_add certify.scope 'Certification scope' pass 'Probes target the configured Anthropic-compatible endpoint.' false
  else
    diag_add certify.scope 'Certification scope' fail 'Certification requires an explicit endpoint and credential; Claude login sessions are not read.' true
  fi

  if [ "$yes" != true ]; then
    if [ "$json" != true ] && [ -t 0 ]; then
      printf 'Certification sends up to three minimal requests and may incur provider charges. Continue? [y/N] '
      read -r ans || true
      case "$ans" in y | Y | yes | YES) yes=true ;; esac
    fi
  fi
  if [ "$yes" != true ]; then
    diag_add certify.consent 'Probe consent' fail 'Active probes require confirmation; pass --yes after user consent.' true
    certify_skip_remaining 'Probe was not run without consent.'
    diag_finish "$json"
    return
  fi
  diag_add certify.consent 'Probe consent' pass 'Active minimal probes were explicitly authorized.' true

  if ! command -v "$CCX_CURL_BIN" >/dev/null 2>&1; then
    diag_add system.curl 'HTTP client' fail 'curl is required for certification.' true
    certify_skip_remaining 'Probe was blocked by failed preflight checks.'
    diag_finish "$json"
    return
  fi
  diag_add system.curl 'HTTP client' pass 'curl is available.' true
  if ! json_parser_available; then
    diag_add system.json_parser 'JSON parser' fail 'python3 or node is required to validate certification responses safely.' true
    certify_skip_remaining 'Probe was blocked because no safe JSON parser is available.'
    diag_finish "$json"
    return
  fi
  diag_add system.json_parser 'JSON parser' pass 'A structured response parser is available.' true

  diag_counts
  if [ "$DIAG_OVERALL" = fail ] || [ "$PROFILE_READY" != true ]; then
    certify_skip_remaining 'Probe was blocked by failed preflight checks.'
    diag_finish "$json"
    return
  fi

  for part in basic streaming tools; do
    case "$selected" in
      *",$part,"*) certify_probe "$part" ;;
      *) certify_add_skipped "$part" 'Capability was not selected.' false ;;
    esac
  done
  diag_finish "$json"
}

# Router teardown reads a script global so it works as a trap handler regardless
# of call site. ccx-router runs in the foreground (we background it ourselves),
# so killing the spawned PID is enough — no config dir or PID file to clean up.
router_teardown() {
  [ -n "${CCX_ROUTER_TORN:-}" ] && return 0
  CCX_ROUTER_TORN=1
  if [ -n "${CCX_ROUTER_PID:-}" ]; then kill "$CCX_ROUTER_PID" 2>/dev/null || true; fi
  return 0
}

cmd_help() {
  cat <<'EOF'
Usage: ccx <profile> [claude args...]   launch claude with a profile
       ccx new                          create a profile (wizard / flags)
       ccx list                         list profiles
       ccx doctor [profile]             diagnose setup/profile (--json)
       ccx certify <profile>            run opt-in capability probes
       ccx logs <profile> [--follow]    show redacted router events
       ccx show <profile>               show a profile (token masked)
       ccx edit <profile>               edit a profile in $EDITOR
       ccx rm <profile>                 remove a profile
       ccx help                         this help
EOF
}

cmd_list() {
  local pd; pd="$(profiles_dir)"
  local found=0 d name penv prov url model router
  if [ -d "$pd" ]; then
    for d in "$pd"/*/; do
      [ -d "$d" ] || continue
      penv="$d/profile.env"; [ -f "$penv" ] || continue
      found=1
      name="$(basename "$d")"
      prov="$(kv_get "$penv" CCX_PROVIDER)"
      router="$(kv_get "$penv" CCX_ROUTER)"
      model="$(kv_get "$penv" ANTHROPIC_MODEL)"
      if [ -n "$router" ]; then
        url="$(kv_get "$penv" CCX_UPSTREAM_BASE_URL)"
      else
        url="$(kv_get "$penv" ANTHROPIC_BASE_URL)"
      fi
      printf '%-16s %-10s %-34s %s\n' "$name" "${prov:-?}" "${url:-(anthropic login)}" "${model:-}"
    done
  fi
  [ "$found" -eq 1 ] || printf 'No profiles yet. Create one: ccx new\n'
}

cmd_new() {
  local name="" provider="" base_url="" token="" model="" model_set="" \
        m_opus="" m_sonnet="" m_haiku="" isolate="" yes="" \
        router="" upstream_url="" upstream_key="" fallback_urls="" \
        fallback_keys="" router_attempts="" fallback_key_args=0 \
        pin_only="" pin_order="" pin_require="" fb_pin_only="" fb_pin_order="" \
        fb_pin_require="" fb_pin_only_args=0 fb_pin_order_args=0 fb_pin_require_args=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --provider) provider="$2"; shift 2 ;;
      --base-url) base_url="$2"; shift 2 ;;
      --token) token="$2"; shift 2 ;;
      --token-stdin)
        IFS= read -r token || [ -n "$token" ] || die 'new: could not read token from stdin'
        shift ;;
      --model) model="$2"; model_set=1; shift 2 ;;
      --opus) m_opus="$2"; shift 2 ;;
      --sonnet) m_sonnet="$2"; shift 2 ;;
      --haiku) m_haiku="$2"; shift 2 ;;
      --upstream-url) upstream_url="$2"; shift 2 ;;
      --upstream-key) upstream_key="$2"; shift 2 ;;
      --upstream-key-stdin)
        IFS= read -r upstream_key || [ -n "$upstream_key" ] || die 'new: could not read upstream key from stdin'
        shift ;;
      --fallback-url)
        [ $# -ge 2 ] || die 'new: --fallback-url requires a value'
        case "$2" in *','*) die 'new: fallback URLs cannot contain commas' ;; esac
        fallback_urls="${fallback_urls:+$fallback_urls,}$2"; shift 2 ;;
      --fallback-key)
        [ $# -ge 2 ] || die 'new: --fallback-key requires a value'
        case "$2" in *','*) die 'new: fallback keys cannot contain commas' ;; esac
        [ "$fallback_key_args" -eq 0 ] || fallback_keys="$fallback_keys,"
        fallback_keys="$fallback_keys$2"; fallback_key_args=$((fallback_key_args + 1)); shift 2 ;;
      --fallback-key-stdin)
        local stdin_fallback_key=""
        IFS= read -r stdin_fallback_key \
          || [ -n "$stdin_fallback_key" ] \
          || die 'new: could not read fallback key from stdin'
        case "$stdin_fallback_key" in *','*) die 'new: fallback keys cannot contain commas' ;; esac
        [ "$fallback_key_args" -eq 0 ] || fallback_keys="$fallback_keys,"
        fallback_keys="$fallback_keys$stdin_fallback_key"
        fallback_key_args=$((fallback_key_args + 1)); shift ;;
      --router-attempts)
        [ $# -ge 2 ] || die 'new: --router-attempts requires a value'
        router_attempts="$2"; shift 2 ;;
      --provider-only)
        [ $# -ge 2 ] || die 'new: --provider-only requires a value'
        case "$2" in *';'*) die 'new: provider pinning values cannot contain semicolons' ;; esac
        pin_only="$2"; shift 2 ;;
      --provider-order)
        [ $# -ge 2 ] || die 'new: --provider-order requires a value'
        case "$2" in *';'*) die 'new: provider pinning values cannot contain semicolons' ;; esac
        pin_order="$2"; shift 2 ;;
      --require-parameters) pin_require=1; shift ;;
      --fallback-provider-only)
        [ $# -ge 2 ] || die 'new: --fallback-provider-only requires a value'
        case "$2" in *';'*) die 'new: provider pinning values cannot contain semicolons' ;; esac
        [ "$fb_pin_only_args" -eq 0 ] || fb_pin_only="$fb_pin_only;"
        fb_pin_only="$fb_pin_only$2"
        fb_pin_only_args=$((fb_pin_only_args + 1)); shift 2 ;;
      --fallback-provider-order)
        [ $# -ge 2 ] || die 'new: --fallback-provider-order requires a value'
        case "$2" in *';'*) die 'new: provider pinning values cannot contain semicolons' ;; esac
        [ "$fb_pin_order_args" -eq 0 ] || fb_pin_order="$fb_pin_order;"
        fb_pin_order="$fb_pin_order$2"
        fb_pin_order_args=$((fb_pin_order_args + 1)); shift 2 ;;
      --fallback-require-parameters)
        # Positional like --fallback-key, so it takes a value: a bare flag
        # could not express "leave fallback #1 alone but pin fallback #2".
        [ $# -ge 2 ] || die 'new: --fallback-require-parameters requires a value'
        [ "$fb_pin_require_args" -eq 0 ] || fb_pin_require="$fb_pin_require;"
        case "$2" in
          1 | true) fb_pin_require="${fb_pin_require}1" ;;
          0 | false | '') ;;
          *) die 'new: --fallback-require-parameters must be 1 or 0' ;;
        esac
        fb_pin_require_args=$((fb_pin_require_args + 1)); shift 2 ;;
      --isolate) isolate=true; shift ;;
      --no-isolate) isolate=false; shift ;;
      --yes | -y) yes=1; shift ;;
      -h | --help)
        cat <<'EOF'
Usage: ccx new [--name NAME] [--provider PROVIDER] [--model MODEL] [--yes]
               [--base-url URL] [--token TOKEN|--token-stdin]
               [--upstream-url URL] [--upstream-key KEY|--upstream-key-stdin]
               [--fallback-url URL ...] [--fallback-key KEY|--fallback-key-stdin ...]
               [--router-attempts 1..10]
               [--provider-only SLUGS] [--provider-order SLUGS] [--require-parameters]
               [--fallback-provider-only SLUGS ...] [--fallback-provider-order SLUGS ...]
               [--fallback-require-parameters 1|0 ...]

OpenRouter provider pinning takes comma-separated provider slugs and applies to
one upstream each: the --provider-* flags pin the primary, and each repeated
--fallback-provider-* flag pins the --fallback-url at the same position.
--require-parameters asks OpenRouter for providers that support the request's
parameters, which is what keeps a non-tool-capable endpoint out of the way.

Prefer the hidden interactive prompt or *-stdin options for secrets. Supplying a
secret directly as an argument can expose it to shell history and process tools.
EOF
        return 0
        ;;
      *) die "new: unknown option: $1" ;;
    esac
  done

  [ -n "$name" ] || { printf 'Profile name: '; read -r name; }
  valid_profile_name "$name" || die "invalid name: $name"
  [ -e "$(profile_dir "$name")" ] && die "profile already exists: $name"
  [ -n "$provider" ] || choose_provider
  [ -n "$provider" ] || die "provider is required"
  valid_profile_name "$provider" || die 'provider name must contain only letters, digits, _ or -'

  local tf has_opus="" has_sonnet="" has_haiku=""
  tf="$(template_file "$provider")"
  if [ -n "$tf" ]; then
    router="$(kv_get "$tf" CCX_ROUTER)"
    [ -n "$base_url" ]     || base_url="$(kv_get "$tf" ANTHROPIC_BASE_URL)"
    [ -n "$model" ]        || model="$(kv_get "$tf" ANTHROPIC_MODEL)"
    [ -n "$upstream_url" ] || upstream_url="$(kv_get "$tf" CCX_UPSTREAM_BASE_URL)"
    has_opus="$(kv_get "$tf" ANTHROPIC_DEFAULT_OPUS_MODEL)"
    has_sonnet="$(kv_get "$tf" ANTHROPIC_DEFAULT_SONNET_MODEL)"
    has_haiku="$(kv_get "$tf" ANTHROPIC_DEFAULT_HAIKU_MODEL)"
    [ -n "$isolate" ]  || isolate="$(kv_get "$tf" CCX_ISOLATE)"
  fi
  [ -n "$isolate" ] || isolate=true
  case "$isolate" in true | false) ;; *) die 'CCX_ISOLATE must be true or false' ;; esac
  if [ -z "$router" ] && { [ -n "$fallback_urls" ] || [ -n "$fallback_keys" ] || [ -n "$router_attempts" ]; }; then
    die 'new: fallback options are only valid for OpenAI-compatible router providers'
  fi
  if [ "$fallback_key_args" -gt 0 ] && [ -z "$fallback_urls" ]; then
    die 'new: --fallback-key requires at least one --fallback-url'
  fi
  if [ -z "$router" ] && { [ -n "$pin_only" ] || [ -n "$pin_order" ] || [ -n "$pin_require" ] \
    || [ -n "$fb_pin_only" ] || [ -n "$fb_pin_order" ] || [ -n "$fb_pin_require" ]; }; then
    die 'new: provider pinning is only valid for OpenAI-compatible router providers'
  fi
  if [ -z "$fallback_urls" ] \
    && { [ "$fb_pin_only_args" -gt 0 ] || [ "$fb_pin_order_args" -gt 0 ] \
      || [ "$fb_pin_require_args" -gt 0 ]; }; then
    die 'new: fallback provider pinning requires at least one --fallback-url'
  fi
  pin_only="$(join_pinning "$pin_only" "$fb_pin_only")"
  pin_order="$(join_pinning "$pin_order" "$fb_pin_order")"
  pin_require="$(join_pinning "$pin_require" "$fb_pin_require")"
  local pin_max=1
  [ -z "$fallback_urls" ] || pin_max=$((1 + $(csv_entry_count "$fallback_urls")))
  validate_provider_pinning CCX_ROUTER_PROVIDER_ONLY "$pin_only" "$pin_max"
  validate_provider_pinning CCX_ROUTER_PROVIDER_ORDER "$pin_order" "$pin_max"
  validate_require_parameters CCX_ROUTER_REQUIRE_PARAMETERS "$pin_require" "$pin_max"
  if [ -n "$router_attempts" ]; then
    case "$router_attempts" in '' | *[!0-9]*) die 'new: --router-attempts must be between 1 and 10' ;; esac
    [ "$router_attempts" -ge 1 ] && [ "$router_attempts" -le 10 ] \
      || die 'new: --router-attempts must be between 1 and 10'
  fi

  # A custom provider (no template) has no endpoint baked in — ask for it so the
  # profile is usable, and so its model list can be fetched. (custom-oai covers
  # the OpenAI-compatible case through the upstream-URL prompt below instead.)
  if [ -z "$tf" ] && [ -z "$router" ] && [ -z "$base_url" ] && [ -z "$yes" ]; then
    printf 'Base URL (Anthropic-compatible endpoint): '
    local bu=""; read -r bu || true
    [ -n "$bu" ] && base_url="$bu"
  fi

  # --- credentials first, so the live model list can be queried from the API ---
  if [ -n "$router" ]; then
    # Confirm/enter the upstream endpoint (template default shown in brackets).
    if [ -z "$yes" ]; then
      printf 'Upstream base URL [%s]: ' "$upstream_url"
      local au=""; read -r au || true
      [ -n "$au" ] && upstream_url="$au"
    fi
    # Upstream key: prompt (hidden) only when interactive, missing, and the
    # endpoint is remote — local servers (Ollama/vLLM/LM Studio) need no key.
    if [ -z "$upstream_key" ] && [ -z "$yes" ]; then
      case "$upstream_url" in
        '' | *localhost* | *127.0.0.1*) : ;;
        *) printf 'Upstream API key (input hidden, empty to skip): '; read -rs upstream_key; printf '\n' ;;
      esac
    fi
  else
    if [ "$provider" != "claude" ] && [ -z "$token" ]; then
      printf 'API token (input hidden): '; read -rs token; printf '\n'
    fi
  fi

  # Validate every value before model discovery or profile serialization. This
  # prevents plaintext credential transport and newline-based env injection.
  require_single_line 'provider' "$provider"
  require_single_line 'API token' "$token" true
  require_single_line 'upstream API key' "$upstream_key" true
  require_single_line 'router type' "$router" true
  if [ -n "$router" ]; then
    require_endpoint_url 'upstream URL' "$upstream_url"
    validate_fallback_config "$fallback_urls" "$fallback_keys"
    local fallback_url_count
    fallback_url_count="$(csv_entry_count "$fallback_urls")"
    [ "$fallback_key_args" -le "$fallback_url_count" ] \
      || die 'more fallback keys than fallback URLs are configured'
  elif [ -n "$base_url" ]; then
    require_endpoint_url 'base URL' "$base_url"
  fi

  # Pick the model interactively unless given with --model or running with -y.
  # choose_model fetches the provider's live /models list when it can, then falls
  # back to the template default + manual entry. Models URL priority:
  # explicit CCX_MODELS_URL > router upstream/models > Anthropic base/v1/models.
  if [ -z "$model_set" ] && [ -z "$yes" ]; then
    local m_url="" m_mode="" m_tok="" models_url_tmpl="" models_auth_tmpl=""
    if [ -n "$tf" ]; then
      models_url_tmpl="$(kv_get "$tf" CCX_MODELS_URL)"
      models_auth_tmpl="$(kv_get "$tf" CCX_MODELS_AUTH)"   # 'bearer' or 'anthropic'
    fi
    case "$models_auth_tmpl" in '' | bearer | anthropic) ;; *) die 'CCX_MODELS_AUTH must be bearer or anthropic' ;; esac
    if   [ -n "$models_url_tmpl" ];                  then m_url="$models_url_tmpl"
    elif [ -n "$router" ] && [ -n "$upstream_url" ]; then m_url="${upstream_url%/}/models"
    elif [ -n "$base_url" ];                         then m_url="${base_url%/}/v1/models"
    fi
    [ -z "$m_url" ] || require_endpoint_url 'model discovery URL' "$m_url"
    # Auth style: router upstreams use Bearer; Anthropic bases use x-api-key.
    # A template may override via CCX_MODELS_AUTH when its list endpoint differs
    # (e.g. kimi lists through Moonshot's OpenAI /v1/models, which wants Bearer).
    if [ -n "$router" ]; then m_mode="openai"; m_tok="$upstream_key"; else m_mode="anthropic"; m_tok="$token"; fi
    [ -n "$models_auth_tmpl" ] && m_mode="$models_auth_tmpl"
    choose_model "$provider" "$model" "$m_url" "$m_mode" "$m_tok"
  fi

  # --- model slot mapping (after the model is chosen) ---
  if [ -n "$router" ]; then
    # Router profile: ccx-router passes the model through, so fill every slot
    # with the chosen model (unless overridden) so /model opus|sonnet|haiku work.
    [ -n "$m_opus" ]   || m_opus="$model"
    [ -n "$m_sonnet" ] || m_sonnet="$model"
    [ -n "$m_haiku" ]  || m_haiku="$model"
  else
    # Single-model profile: each slot the template defines follows the chosen
    # model, unless explicitly overridden with --opus/--sonnet/--haiku.
    if [ -z "$m_opus" ]   && [ -n "$has_opus" ];   then m_opus="$model";   fi
    if [ -z "$m_sonnet" ] && [ -n "$has_sonnet" ]; then m_sonnet="$model"; fi
    if [ -z "$m_haiku" ]  && [ -n "$has_haiku" ];  then m_haiku="$model";  fi
  fi

  require_single_line 'model' "$model" true
  require_single_line 'opus model' "$m_opus" true
  require_single_line 'sonnet model' "$m_sonnet" true
  require_single_line 'haiku model' "$m_haiku" true

  local pdir penv
  pdir="$(profile_dir "$name")"
  mkdir -p "$pdir"
  penv="$pdir/profile.env"
  {
    printf '# ccx profile: %s\n' "$name"
    printf 'CCX_PROVIDER=%s\n' "$provider"
    printf 'CCX_ISOLATE=%s\n' "$isolate"
    if [ -n "$router" ]; then
      # Router-specific keys (CCX_* — never exported to claude). The upstream
      # endpoint and key; ANTHROPIC_BASE_URL is set at launch by run_router.
      printf 'CCX_ROUTER=%s\n' "$router"
      [ -n "$upstream_url" ] && printf 'CCX_UPSTREAM_BASE_URL=%s\n' "$upstream_url"
      [ -n "$upstream_key" ] && printf 'CCX_UPSTREAM_API_KEY=%s\n' "$upstream_key"
      [ -n "$fallback_urls" ] && printf 'CCX_ROUTER_FALLBACK_URLS=%s\n' "$fallback_urls"
      [ -n "$fallback_keys" ] && printf 'CCX_ROUTER_FALLBACK_KEYS=%s\n' "$fallback_keys"
      [ -n "$router_attempts" ] && printf 'CCX_ROUTER_ATTEMPTS_PER_UPSTREAM=%s\n' "$router_attempts"
      [ -n "$pin_only" ] && printf 'CCX_ROUTER_PROVIDER_ONLY=%s\n' "$pin_only"
      [ -n "$pin_order" ] && printf 'CCX_ROUTER_PROVIDER_ORDER=%s\n' "$pin_order"
      [ -n "$pin_require" ] && printf 'CCX_ROUTER_REQUIRE_PARAMETERS=%s\n' "$pin_require"
    else
      [ -n "$base_url" ] && printf 'ANTHROPIC_BASE_URL=%s\n' "$base_url"
      [ -n "$token" ]    && printf 'ANTHROPIC_AUTH_TOKEN=%s\n' "$token"
    fi
    # Model + slot mapping is shared: both kinds pass these to claude (router
    # profiles' models are upstream IDs forwarded as-is by ccx-router).
    [ -n "$model" ]    && printf 'ANTHROPIC_MODEL=%s\n' "$model"
    [ -n "$m_opus" ]   && printf 'ANTHROPIC_DEFAULT_OPUS_MODEL=%s\n' "$m_opus"
    [ -n "$m_sonnet" ] && printf 'ANTHROPIC_DEFAULT_SONNET_MODEL=%s\n' "$m_sonnet"
    [ -n "$m_haiku" ]  && printf 'ANTHROPIC_DEFAULT_HAIKU_MODEL=%s\n' "$m_haiku"
  } > "$penv"
  chmod 600 "$penv"
  if [ "$isolate" = "true" ]; then mkdir -p "$pdir/home"; chmod 700 "$pdir/home"; fi

  printf 'Created profile "%s". Run it: ccx %s\n' "$name" "$name"
}

run_router() { # name provider [claude args...] — bring up ccx-router, then run claude
  local name="$1" provider="$2"; shift 2
  local pdir penv router port apikey upstream_url upstream_key bin \
        fallback_urls fallback_keys attempts connect_timeout response_timeout \
        stream_idle_timeout stream_ping_interval stream_usage router_log log_file \
        pin_only pin_order pin_require pin_max
  pdir="$(profile_dir "$name")"
  penv="$pdir/profile.env"
  router="$(kv_get "$penv" CCX_ROUTER)"
  upstream_url="$(kv_get "$penv" CCX_UPSTREAM_BASE_URL)"
  upstream_key="$(kv_get "$penv" CCX_UPSTREAM_API_KEY)"
  fallback_urls="${CCX_ROUTER_FALLBACK_URLS:-$(kv_get "$penv" CCX_ROUTER_FALLBACK_URLS)}"
  fallback_keys="${CCX_ROUTER_FALLBACK_KEYS:-$(kv_get "$penv" CCX_ROUTER_FALLBACK_KEYS)}"
  attempts="${CCX_ROUTER_ATTEMPTS_PER_UPSTREAM:-$(kv_get "$penv" CCX_ROUTER_ATTEMPTS_PER_UPSTREAM)}"
  connect_timeout="${CCX_ROUTER_CONNECT_TIMEOUT_MS:-$(kv_get "$penv" CCX_ROUTER_CONNECT_TIMEOUT_MS)}"
  response_timeout="${CCX_ROUTER_RESPONSE_TIMEOUT_MS:-$(kv_get "$penv" CCX_ROUTER_RESPONSE_TIMEOUT_MS)}"
  stream_idle_timeout="${CCX_ROUTER_STREAM_IDLE_TIMEOUT_MS:-$(kv_get "$penv" CCX_ROUTER_STREAM_IDLE_TIMEOUT_MS)}"
  stream_ping_interval="${CCX_ROUTER_STREAM_PING_INTERVAL_MS:-$(kv_get "$penv" CCX_ROUTER_STREAM_PING_INTERVAL_MS)}"
  stream_usage="${CCX_ROUTER_STREAM_USAGE:-$(kv_get "$penv" CCX_ROUTER_STREAM_USAGE)}"
  router_log="${CCX_ROUTER_LOG:-$(kv_get "$penv" CCX_ROUTER_LOG)}"
  pin_only="${CCX_ROUTER_PROVIDER_ONLY:-$(kv_get "$penv" CCX_ROUTER_PROVIDER_ONLY)}"
  pin_order="${CCX_ROUTER_PROVIDER_ORDER:-$(kv_get "$penv" CCX_ROUTER_PROVIDER_ORDER)}"
  pin_require="${CCX_ROUTER_REQUIRE_PARAMETERS:-$(kv_get "$penv" CCX_ROUTER_REQUIRE_PARAMETERS)}"
  [ -n "$router_log" ] || router_log=json
  log_file="$pdir/router.log"

  require_single_line 'upstream API key' "$upstream_key" true
  require_endpoint_url 'upstream URL' "$upstream_url"
  validate_fallback_config "$fallback_urls" "$fallback_keys"
  pin_max=1
  [ -z "$fallback_urls" ] || pin_max=$((1 + $(csv_entry_count "$fallback_urls")))
  validate_provider_pinning CCX_ROUTER_PROVIDER_ONLY "$pin_only" "$pin_max"
  validate_provider_pinning CCX_ROUTER_PROVIDER_ORDER "$pin_order" "$pin_max"
  validate_require_parameters CCX_ROUTER_REQUIRE_PARAMETERS "$pin_require" "$pin_max"
  if [ -n "$attempts" ]; then
    case "$attempts" in *[!0-9]*) die 'attempts per upstream must be between 1 and 10' ;; esac
    [ "$attempts" -ge 1 ] && [ "$attempts" -le 10 ] \
      || die 'attempts per upstream must be between 1 and 10'
  fi
  local timeout_value timeout_label
  for timeout_label in connect_timeout response_timeout stream_idle_timeout stream_ping_interval; do
    case "$timeout_label" in
      connect_timeout) timeout_value="$connect_timeout" ;;
      response_timeout) timeout_value="$response_timeout" ;;
      stream_idle_timeout) timeout_value="$stream_idle_timeout" ;;
      stream_ping_interval) timeout_value="$stream_ping_interval" ;;
    esac
    if [ -n "$timeout_value" ]; then
      case "$timeout_value" in *[!0-9]*) die 'router timeout values must be positive integers' ;; esac
      [ "$timeout_value" -gt 0 ] || die 'router timeout values must be positive integers'
    fi
  done
  case "$stream_usage" in '' | auto | on | off) ;; *) die 'CCX_ROUTER_STREAM_USAGE must be auto, on, or off' ;; esac
  case "$router_log" in json | off) ;; *) die 'CCX_ROUTER_LOG must be json or off' ;; esac
  port="$(pick_free_port)"
  apikey="$(gen_apikey)"
  # Auto mode's server-side classifier needs Anthropic's API to see the
  # `safeguards` field; an OpenAI-compatible upstream never can, so skip asking
  # (Claude Code otherwise holds the first checked action behind a notice).
  # A value from the profile or the shell wins.
  export CLAUDE_CODE_AUTO_MODE_SERVER="${CLAUDE_CODE_AUTO_MODE_SERVER:-0}"

  if [ "${CCX_DRY_RUN:-}" = "1" ]; then
    bin="$(resolve_router_bin || printf '%s' "$CCX_ROUTER_BIN")"
    printf 'CCX_DRY_RUN profile=%s provider=%s router=%s\n' "$name" "$provider" "$router"
    printf 'router: %s --port %s --upstream-url %s\n' "$bin" "$port" "$upstream_url"
    printf 'env: CCX_ROUTER_API_KEY=%s\n' "$(mask_token "$apikey")"
    [ -n "$upstream_key" ] && printf 'env: CCX_ROUTER_UPSTREAM_KEY=%s\n' "$(mask_token "$upstream_key")"
    [ -n "$fallback_urls" ] && printf 'env: CCX_ROUTER_FALLBACK_URLS=%s\n' "$fallback_urls"
    [ -n "$fallback_keys" ] && printf 'env: CCX_ROUTER_FALLBACK_KEYS=(configured, hidden)\n'
    [ -n "$attempts" ] && printf 'env: CCX_ROUTER_ATTEMPTS_PER_UPSTREAM=%s\n' "$attempts"
    [ -n "$pin_only" ] && printf 'env: CCX_ROUTER_PROVIDER_ONLY=%s\n' "$pin_only"
    [ -n "$pin_order" ] && printf 'env: CCX_ROUTER_PROVIDER_ORDER=%s\n' "$pin_order"
    [ -n "$pin_require" ] && printf 'env: CCX_ROUTER_REQUIRE_PARAMETERS=%s\n' "$pin_require"
    printf 'env: CCX_ROUTER_LOG=%s\n' "$router_log"
    printf 'env: ANTHROPIC_BASE_URL=http://127.0.0.1:%s\n' "$port"
    printf 'env: ANTHROPIC_AUTH_TOKEN=%s\n' "$(mask_token "$apikey")"
    printf 'env: CLAUDE_CODE_AUTO_MODE_SERVER=%s\n' "$CLAUDE_CODE_AUTO_MODE_SERVER"
    [ -n "${CLAUDE_CONFIG_DIR:-}" ] && printf 'env: CLAUDE_CONFIG_DIR=%s\n' "$CLAUDE_CONFIG_DIR"
    printf 'exec: %s %s\n' "$CCX_CLAUDE_BIN" "$*"
    exit 0
  fi

  # --- live launch ---
  bin="$(resolve_router_bin)" || die \
    "ccx-router not found (looked for '$CCX_ROUTER_BIN' and router/target/release/ccx-router). Build it: cargo build --release --manifest-path router/Cargo.toml  — or set CCX_ROUTER_BIN."
  command -v "$CCX_CLAUDE_BIN" >/dev/null 2>&1 || die \
    "claude not found (looked for '$CCX_CLAUDE_BIN'). Install Claude Code or set CCX_CLAUDE_BIN."
  [ -n "$upstream_url" ] || die "profile '$name' has no CCX_UPSTREAM_BASE_URL"

  CCX_ROUTER_TORN=""
  trap router_teardown EXIT INT TERM
  # Replace (rather than truncate) any previous path, so a malicious symlink at
  # router.log is never followed. mktemp creates the new inode mode 0600 under
  # the process-wide private umask.
  local log_tmp
  log_tmp="$(mktemp "$pdir/.router.log.XXXXXX")" || die 'cannot create private router log'
  chmod 600 "$log_tmp"
  mv -f -- "$log_tmp" "$log_file"
  CCX_ROUTER_API_KEY="$apikey" \
  CCX_ROUTER_UPSTREAM_KEY="$upstream_key" \
  CCX_ROUTER_FALLBACK_URLS="$fallback_urls" \
  CCX_ROUTER_FALLBACK_KEYS="$fallback_keys" \
  CCX_ROUTER_ATTEMPTS_PER_UPSTREAM="$attempts" \
  CCX_ROUTER_PROVIDER_ONLY="$pin_only" \
  CCX_ROUTER_PROVIDER_ORDER="$pin_order" \
  CCX_ROUTER_REQUIRE_PARAMETERS="$pin_require" \
  CCX_ROUTER_CONNECT_TIMEOUT_MS="$connect_timeout" \
  CCX_ROUTER_RESPONSE_TIMEOUT_MS="$response_timeout" \
  CCX_ROUTER_STREAM_IDLE_TIMEOUT_MS="$stream_idle_timeout" \
  CCX_ROUTER_STREAM_PING_INTERVAL_MS="$stream_ping_interval" \
  CCX_ROUTER_STREAM_USAGE="$stream_usage" \
  CCX_ROUTER_LOG="$router_log" \
    "$bin" --port "$port" --upstream-url "$upstream_url" >/dev/null 2>>"$log_file" &
  CCX_ROUTER_PID=$!

  # Readiness = the port accepts a TCP connection (dependency-free, no curl).
  local timeout="${CCX_ROUTER_TIMEOUT:-15}" waited=0 ready=""
  while [ "$waited" -lt "$timeout" ]; do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then ready=1; break; fi
    sleep 1; waited=$((waited + 1))
  done
  if [ -z "$ready" ]; then
    router_teardown
    [ ! -s "$log_file" ] || { printf 'ccx: router log:\n' >&2; tail -n 20 "$log_file" >&2; }
    die "ccx-router did not become ready on 127.0.0.1:$port within ${timeout}s"
  fi

  printf 'ccx: router ready on http://127.0.0.1:%s (%s); log: %s\n' "$port" "$provider" "$log_file" >&2
  export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
  export ANTHROPIC_AUTH_TOKEN="$apikey"

  # Run claude as a child (not exec) so the trap still fires for teardown.
  # `|| code=$?` keeps a non-zero claude exit from tripping `set -e` and
  # skipping teardown.
  local code=0
  "$CCX_CLAUDE_BIN" "$@" || code=$?
  router_teardown
  exit "$code"
}

cmd_run() {
  local name="${1:-}"
  [ -n "$name" ] || { cmd_help; exit 0; }
  valid_profile_name "$name" || die "invalid profile name: $name"
  shift || true
  local penv; penv="$(profile_env "$name")"
  if [ ! -f "$penv" ]; then
    printf 'ccx: unknown profile: %s\n\nAvailable profiles:\n' "$name" >&2
    cmd_list >&2
    exit 1
  fi
  profile_syntax_valid "$penv" \
    || die "profile '$name' is malformed or contains duplicate environment keys; run: ccx doctor $name --no-network"

  local mode; mode="$(stat -c '%a' "$penv" 2>/dev/null || stat -f '%Lp' "$penv")"
  if [ "$mode" != "600" ]; then
    printf 'ccx: warning: %s has mode %s (expected 600); run: chmod 600 %s\n' "$penv" "$mode" "$penv" >&2
  fi

  local isolate=false provider="" router="" base_url="" model="" key val
  local -a exports=()
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | '#'*) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    case "$key" in
      CCX_ISOLATE) isolate="$val" ;;
      CCX_PROVIDER) provider="$val" ;;
      CCX_ROUTER) router="$val" ;;
      CCX_*) : ;;
      ANTHROPIC_*)
        export "$key=$val"; exports+=("$key=$val")
        [ "$key" != ANTHROPIC_BASE_URL ] || base_url="$val"
        [ "$key" != ANTHROPIC_MODEL ] || model="$val"
        ;;
      *) die "unsupported profile environment key: $key" ;;
    esac
  done < "$penv"

  case "$isolate" in true | false) ;; *) die "profile '$name' has invalid CCX_ISOLATE (expected true or false)" ;; esac
  require_single_line 'profile provider' "$provider"
  require_single_line 'profile model' "$model"

  if [ "$isolate" = "true" ]; then
    local home; home="$(profile_dir "$name")/home"
    mkdir -p "$home"; chmod 700 "$home"
    export CLAUDE_CONFIG_DIR="$home"
    exports+=("CLAUDE_CONFIG_DIR=$home")
  fi

  # OpenAI-compatible profiles route through a local ccx-router (separate path).
  if [ -n "$router" ]; then
    run_router "$name" "$provider" "$@"
    return
  fi
  [ -z "$base_url" ] || require_endpoint_url 'profile base URL' "$base_url"

  if [ "${CCX_DRY_RUN:-}" = "1" ]; then
    printf 'CCX_DRY_RUN profile=%s provider=%s\n' "$name" "$provider"
    local e k
    for e in "${exports[@]}"; do
      k="${e%%=*}"
      case "$k" in
        *TOKEN* | *API_KEY*) printf 'env: %s=%s\n' "$k" "$(mask_token "${e#*=}")" ;;
        *) printf 'env: %s\n' "$e" ;;
      esac
    done
    printf 'exec: %s %s\n' "$CCX_CLAUDE_BIN" "$*"
    exit 0
  fi

  command -v "$CCX_CLAUDE_BIN" >/dev/null 2>&1 \
    || die "claude not found (looked for '$CCX_CLAUDE_BIN'). Install Claude Code or set CCX_CLAUDE_BIN."
  exec "$CCX_CLAUDE_BIN" "$@"
}

cmd_show() {
  local name="${1:-}"; [ -n "$name" ] || die "show: profile name required"
  valid_profile_name "$name" || die "invalid profile name: $name"
  local penv; penv="$(profile_env "$name")"
  [ -f "$penv" ] || die "unknown profile: $name"
  profile_syntax_valid "$penv" || die "profile '$name' is malformed or contains duplicate keys"
  while IFS= read -r line || [ -n "$line" ]; do
    local show_key="${line%%=*}"
    case "$show_key" in
      *TOKEN* | *API_KEY* | *SECRET* | CCX_ROUTER_FALLBACK_KEYS)
        printf '%s=%s\n' "${line%%=*}" "$(mask_token "${line#*=}")" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$penv"
}

cmd_logs() {
  local name="${1:-}" follow=false lines="${CCX_LOG_LINES:-100}"
  [ -n "$name" ] || die 'logs: profile name required'
  valid_profile_name "$name" || die "invalid profile name: $name"
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      -f | --follow) follow=true; shift ;;
      --lines)
        [ $# -ge 2 ] || die 'logs: --lines requires a value'
        lines="$2"; shift 2 ;;
      *) die "logs: unknown option: $1" ;;
    esac
  done
  case "$lines" in '' | *[!0-9]*) die 'logs: --lines must be a positive integer' ;; esac
  [ "$lines" -gt 0 ] || die 'logs: --lines must be a positive integer'
  local log_file; log_file="$(profile_dir "$name")/router.log"
  [ -f "$log_file" ] && [ ! -L "$log_file" ] \
    || die "no safe regular router log for profile '$name'; launch it first"
  if [ "$follow" = true ]; then tail -n "$lines" -f "$log_file"; else tail -n "$lines" "$log_file"; fi
}

cmd_edit() {
  local name="${1:-}"; [ -n "$name" ] || die "edit: profile name required"
  valid_profile_name "$name" || die "invalid profile name: $name"
  local penv; penv="$(profile_env "$name")"
  [ -f "$penv" ] || die "unknown profile: $name"
  "${EDITOR:-vi}" "$penv"
  chmod 600 "$penv"
}

cmd_rm() {
  local name="${1:-}"; [ -n "$name" ] || die "rm: profile name required"
  valid_profile_name "$name" || die "invalid profile name: $name"
  local pdir; pdir="$(profile_dir "$name")"
  [ -d "$pdir" ] || die "unknown profile: $name"
  if [ "${CCX_YES:-}" != "1" ]; then
    printf 'Remove profile "%s" and its isolated config? [y/N] ' "$name"
    local ans; read -r ans
    case "$ans" in y | Y) ;; *) printf 'Aborted.\n'; return 0 ;; esac
  fi
  rm -rf "$pdir"
  printf 'Removed profile "%s".\n' "$name"
}

cmd_version() {
  printf 'ccx %s\n' "$CCX_VERSION"
  local bin rv
  if bin="$(resolve_router_bin 2>/dev/null)" && [ -n "$bin" ]; then
    # `|| rv=""` so an old router without --version (exit 2) doesn't trip set -e.
    rv="$("$bin" --version 2>/dev/null | head -1)" || rv=""
    [ -n "$rv" ] && printf '%s\n' "$rv" || printf 'ccx-router: found (%s)\n' "$bin"
  else
    printf 'ccx-router: not found\n'
  fi
  if command -v "$CCX_CLAUDE_BIN" >/dev/null 2>&1; then
    local cv; cv="$("$CCX_CLAUDE_BIN" --version 2>/dev/null | head -1)" || cv=""
    printf 'claude: %s\n' "${cv:-found}"
  else
    printf 'claude: not found\n'
  fi
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    help | -h | --help) cmd_help ;;
    version | --version | -V) cmd_version ;;
    list | ls) cmd_list ;;
    new) shift; cmd_new "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    certify) shift; cmd_certify "$@" ;;
    logs | log) shift; cmd_logs "$@" ;;
    show) shift; cmd_show "$@" ;;
    edit) shift; cmd_edit "$@" ;;
    rm | remove | delete) shift; cmd_rm "$@" ;;
    __freeport) pick_free_port; printf '\n' ;;
    __apikey) gen_apikey; printf '\n' ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"
