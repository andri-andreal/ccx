#!/usr/bin/env bash
set -euo pipefail

CCX_HOME="${CCX_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/ccx}"
CCX_CLAUDE_BIN="${CCX_CLAUDE_BIN:-claude}"
CCX_ROUTER_BIN="${CCX_ROUTER_BIN:-ccx-router}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf 'ccx: %s\n' "$1" >&2; exit "${2:-1}"; }

resolve_router_bin() { # print the ccx-router binary path, or fail
  if command -v "$CCX_ROUTER_BIN" >/dev/null 2>&1; then printf '%s' "$CCX_ROUTER_BIN"; return 0; fi
  if [ "$CCX_ROUTER_BIN" = "ccx-router" ] && [ -x "$SCRIPT_DIR/../router/target/release/ccx-router" ]; then
    printf '%s/../router/target/release/ccx-router' "$SCRIPT_DIR"; return 0
  fi
  return 1
}

profiles_dir() { printf '%s/profiles' "$CCX_HOME"; }
profile_dir()  { printf '%s/profiles/%s' "$CCX_HOME" "$1"; }
profile_env()  { printf '%s/profiles/%s/profile.env' "$CCX_HOME" "$1"; }

template_file() { # echo template path for a provider, or nothing
  if [ -f "$CCX_HOME/providers/$1.tmpl" ]; then
    printf '%s/providers/%s.tmpl' "$CCX_HOME" "$1"
  elif [ -f "$SCRIPT_DIR/../providers/$1.tmpl" ]; then
    printf '%s/../providers/%s.tmpl' "$SCRIPT_DIR" "$1"
  fi
}

kv_get() { # file key -> value (first match)
  awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$1"
}

mask_token() {
  local t="$1"
  if [ "${#t}" -le 8 ]; then printf '****'; else printf '%s…%s' "${t:0:3}" "${t: -4}"; fi
}

pick_free_port() { # print first free TCP port on loopback in 39000-39999
  local p
  for ((p = 39000; p <= 39999; p++)); do
    # A free port refuses the connection: the subshell's exec fails -> we take it.
    if ! (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then
      printf '%s' "$p"; return 0
    fi
  done
  die "no free port found in 39000-39999"
}

gen_apikey() { # print a random URL-safe token to secure the local router hop
  local k=""
  if [ -r /dev/urandom ]; then
    k="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-24)"
  fi
  [ -n "$k" ] || k="ccx${RANDOM}${RANDOM}${RANDOM}"
  printf '%s' "$k"
}

# Router teardown reads a script global so it works as a trap handler regardless
# of call site. ccx-router runs in the foreground (we background it ourselves),
# so killing the spawned PID is enough — no config dir or PID file to clean up.
router_teardown() {
  [ -n "${CCX_ROUTER_TORN:-}" ] && return 0
  CCX_ROUTER_TORN=1
  if [ -n "${CCX_ROUTER_PID:-}" ]; then kill "$CCX_ROUTER_PID" 2>/dev/null || true; fi
  return 0
}

cmd_help() {
  cat <<'EOF'
Usage: ccx <profile> [claude args...]   launch claude with a profile
       ccx new                          create a profile (wizard / flags)
       ccx list                         list profiles
       ccx show <profile>               show a profile (token masked)
       ccx edit <profile>               edit a profile in $EDITOR
       ccx rm <profile>                 remove a profile
       ccx help                         this help
EOF
}

cmd_list() {
  local pd; pd="$(profiles_dir)"
  local found=0 d name penv prov url model router
  if [ -d "$pd" ]; then
    for d in "$pd"/*/; do
      [ -d "$d" ] || continue
      penv="$d/profile.env"; [ -f "$penv" ] || continue
      found=1
      name="$(basename "$d")"
      prov="$(kv_get "$penv" CCX_PROVIDER)"
      router="$(kv_get "$penv" CCX_ROUTER)"
      model="$(kv_get "$penv" ANTHROPIC_MODEL)"
      if [ -n "$router" ]; then
        url="$(kv_get "$penv" CCX_UPSTREAM_BASE_URL)"
      else
        url="$(kv_get "$penv" ANTHROPIC_BASE_URL)"
      fi
      printf '%-16s %-10s %-34s %s\n' "$name" "${prov:-?}" "${url:-(anthropic login)}" "${model:-}"
    done
  fi
  [ "$found" -eq 1 ] || printf 'No profiles yet. Create one: ccx new\n'
}

cmd_new() {
  local name="" provider="" base_url="" token="" model="" model_set="" \
        m_opus="" m_sonnet="" m_haiku="" isolate="" yes="" \
        router="" upstream_url="" upstream_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --provider) provider="$2"; shift 2 ;;
      --base-url) base_url="$2"; shift 2 ;;
      --token) token="$2"; shift 2 ;;
      --model) model="$2"; model_set=1; shift 2 ;;
      --opus) m_opus="$2"; shift 2 ;;
      --sonnet) m_sonnet="$2"; shift 2 ;;
      --haiku) m_haiku="$2"; shift 2 ;;
      --upstream-url) upstream_url="$2"; shift 2 ;;
      --upstream-key) upstream_key="$2"; shift 2 ;;
      --isolate) isolate=true; shift ;;
      --no-isolate) isolate=false; shift ;;
      --yes | -y) yes=1; shift ;;
      *) die "new: unknown option: $1" ;;
    esac
  done

  [ -n "$name" ] || { printf 'Profile name: '; read -r name; }
  printf '%s' "$name" | grep -qE '^[A-Za-z0-9_-]+$' || die "invalid name: $name"
  [ -e "$(profile_dir "$name")" ] && die "profile already exists: $name"
  [ -n "$provider" ] || { printf 'Provider [claude/minimax/glm/deepseek/kimi/openai/openrouter/ollama/vllm/lmstudio/sakana/custom]: '; read -r provider; }

  local tf has_opus="" has_sonnet="" has_haiku=""
  tf="$(template_file "$provider")"
  if [ -n "$tf" ]; then
    router="$(kv_get "$tf" CCX_ROUTER)"
    [ -n "$base_url" ]     || base_url="$(kv_get "$tf" ANTHROPIC_BASE_URL)"
    [ -n "$model" ]        || model="$(kv_get "$tf" ANTHROPIC_MODEL)"
    [ -n "$upstream_url" ] || upstream_url="$(kv_get "$tf" CCX_UPSTREAM_BASE_URL)"
    has_opus="$(kv_get "$tf" ANTHROPIC_DEFAULT_OPUS_MODEL)"
    has_sonnet="$(kv_get "$tf" ANTHROPIC_DEFAULT_SONNET_MODEL)"
    has_haiku="$(kv_get "$tf" ANTHROPIC_DEFAULT_HAIKU_MODEL)"
    [ -n "$isolate" ]  || isolate="$(kv_get "$tf" CCX_ISOLATE)"
  fi
  [ -n "$isolate" ] || isolate=true

  # Pick the model interactively unless given with --model or running non-interactively (-y).
  if [ -z "$model_set" ] && [ -z "$yes" ]; then
    if [ -n "$model" ]; then printf 'Model [%s]: ' "$model"; else printf 'Model: '; fi
    local ans=""; read -r ans || true
    [ -n "$ans" ] && model="$ans"
  fi

  if [ -n "$router" ]; then
    # Confirm/enter the upstream endpoint (template default shown in brackets).
    if [ -z "$yes" ]; then
      printf 'Upstream base URL [%s]: ' "$upstream_url"
      local au=""; read -r au || true
      [ -n "$au" ] && upstream_url="$au"
    fi
    # Router profile: ccx-router passes the model through, so fill every slot
    # with the chosen model (unless overridden) — exactly like a single-model
    # Anthropic profile, so /model opus|sonnet|haiku keep working.
    [ -n "$m_opus" ]   || m_opus="$model"
    [ -n "$m_sonnet" ] || m_sonnet="$model"
    [ -n "$m_haiku" ]  || m_haiku="$model"
    # Upstream key: prompt (hidden) only when interactive, missing, and the
    # endpoint is remote — local servers (Ollama/vLLM/LM Studio) need no key.
    if [ -z "$upstream_key" ] && [ -z "$yes" ]; then
      case "$upstream_url" in
        '' | *localhost* | *127.0.0.1*) : ;;
        *) printf 'Upstream API key (input hidden, empty to skip): '; read -rs upstream_key; printf '\n' ;;
      esac
    fi
  else
    # Single-model profile: each slot the template defines follows the chosen
    # model, unless explicitly overridden with --opus/--sonnet/--haiku.
    if [ -z "$m_opus" ]   && [ -n "$has_opus" ];   then m_opus="$model";   fi
    if [ -z "$m_sonnet" ] && [ -n "$has_sonnet" ]; then m_sonnet="$model"; fi
    if [ -z "$m_haiku" ]  && [ -n "$has_haiku" ];  then m_haiku="$model";  fi

    if [ "$provider" != "claude" ] && [ -z "$token" ]; then
      printf 'API token (input hidden): '; read -rs token; printf '\n'
    fi
  fi

  local pdir penv
  pdir="$(profile_dir "$name")"
  mkdir -p "$pdir"
  penv="$pdir/profile.env"
  {
    printf '# ccx profile: %s\n' "$name"
    printf 'CCX_PROVIDER=%s\n' "$provider"
    printf 'CCX_ISOLATE=%s\n' "$isolate"
    if [ -n "$router" ]; then
      # Router-specific keys (CCX_* — never exported to claude). The upstream
      # endpoint and key; ANTHROPIC_BASE_URL is set at launch by run_router.
      printf 'CCX_ROUTER=%s\n' "$router"
      [ -n "$upstream_url" ] && printf 'CCX_UPSTREAM_BASE_URL=%s\n' "$upstream_url"
      [ -n "$upstream_key" ] && printf 'CCX_UPSTREAM_API_KEY=%s\n' "$upstream_key"
    else
      [ -n "$base_url" ] && printf 'ANTHROPIC_BASE_URL=%s\n' "$base_url"
      [ -n "$token" ]    && printf 'ANTHROPIC_AUTH_TOKEN=%s\n' "$token"
    fi
    # Model + slot mapping is shared: both kinds pass these to claude (router
    # profiles' models are upstream IDs forwarded as-is by ccx-router).
    [ -n "$model" ]    && printf 'ANTHROPIC_MODEL=%s\n' "$model"
    [ -n "$m_opus" ]   && printf 'ANTHROPIC_DEFAULT_OPUS_MODEL=%s\n' "$m_opus"
    [ -n "$m_sonnet" ] && printf 'ANTHROPIC_DEFAULT_SONNET_MODEL=%s\n' "$m_sonnet"
    [ -n "$m_haiku" ]  && printf 'ANTHROPIC_DEFAULT_HAIKU_MODEL=%s\n' "$m_haiku"
  } > "$penv"
  chmod 600 "$penv"
  if [ "$isolate" = "true" ]; then mkdir -p "$pdir/home"; chmod 700 "$pdir/home"; fi

  printf 'Created profile "%s". Run it: ccx %s\n' "$name" "$name"
}

run_router() { # name provider [claude args...] — bring up ccx-router, then run claude
  local name="$1" provider="$2"; shift 2
  local pdir penv router port apikey upstream_url upstream_key bin
  pdir="$(profile_dir "$name")"
  penv="$pdir/profile.env"
  router="$(kv_get "$penv" CCX_ROUTER)"
  upstream_url="$(kv_get "$penv" CCX_UPSTREAM_BASE_URL)"
  upstream_key="$(kv_get "$penv" CCX_UPSTREAM_API_KEY)"
  port="$(pick_free_port)"
  apikey="$(gen_apikey)"

  if [ "${CCX_DRY_RUN:-}" = "1" ]; then
    bin="$(resolve_router_bin || printf '%s' "$CCX_ROUTER_BIN")"
    printf 'CCX_DRY_RUN profile=%s provider=%s router=%s\n' "$name" "$provider" "$router"
    printf 'router: %s --port %s --upstream-url %s\n' "$bin" "$port" "$upstream_url"
    printf 'env: CCX_ROUTER_API_KEY=%s\n' "$(mask_token "$apikey")"
    [ -n "$upstream_key" ] && printf 'env: CCX_ROUTER_UPSTREAM_KEY=%s\n' "$(mask_token "$upstream_key")"
    printf 'env: ANTHROPIC_BASE_URL=http://127.0.0.1:%s\n' "$port"
    printf 'env: ANTHROPIC_AUTH_TOKEN=%s\n' "$(mask_token "$apikey")"
    [ -n "${CLAUDE_CONFIG_DIR:-}" ] && printf 'env: CLAUDE_CONFIG_DIR=%s\n' "$CLAUDE_CONFIG_DIR"
    printf 'exec: %s %s\n' "$CCX_CLAUDE_BIN" "$*"
    exit 0
  fi

  # --- live launch ---
  bin="$(resolve_router_bin)" || die \
    "ccx-router not found (looked for '$CCX_ROUTER_BIN' and router/target/release/ccx-router). Build it: cargo build --release --manifest-path router/Cargo.toml  — or set CCX_ROUTER_BIN."
  command -v "$CCX_CLAUDE_BIN" >/dev/null 2>&1 || die \
    "claude not found (looked for '$CCX_CLAUDE_BIN'). Install Claude Code or set CCX_CLAUDE_BIN."
  [ -n "$upstream_url" ] || die "profile '$name' has no CCX_UPSTREAM_BASE_URL"

  CCX_ROUTER_TORN=""
  trap router_teardown EXIT INT TERM
  CCX_ROUTER_API_KEY="$apikey" CCX_ROUTER_UPSTREAM_KEY="$upstream_key" \
    "$bin" --port "$port" --upstream-url "$upstream_url" >/dev/null 2>&1 &
  CCX_ROUTER_PID=$!

  # Readiness = the port accepts a TCP connection (dependency-free, no curl).
  local timeout="${CCX_ROUTER_TIMEOUT:-15}" waited=0 ready=""
  while [ "$waited" -lt "$timeout" ]; do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then ready=1; break; fi
    sleep 1; waited=$((waited + 1))
  done
  [ -n "$ready" ] || { router_teardown; die \
    "ccx-router did not become ready on 127.0.0.1:$port within ${timeout}s"; }

  printf 'ccx: router ready on http://127.0.0.1:%s (%s)\n' "$port" "$provider" >&2
  export ANTHROPIC_BASE_URL="http://127.0.0.1:$port"
  export ANTHROPIC_AUTH_TOKEN="$apikey"

  # Run claude as a child (not exec) so the trap still fires for teardown.
  # `|| code=$?` keeps a non-zero claude exit from tripping `set -e` and
  # skipping teardown.
  local code=0
  "$CCX_CLAUDE_BIN" "$@" || code=$?
  router_teardown
  exit "$code"
}

cmd_run() {
  local name="${1:-}"
  [ -n "$name" ] || { cmd_help; exit 0; }
  shift || true
  local penv; penv="$(profile_env "$name")"
  if [ ! -f "$penv" ]; then
    printf 'ccx: unknown profile: %s\n\nAvailable profiles:\n' "$name" >&2
    cmd_list >&2
    exit 1
  fi

  local mode; mode="$(stat -c '%a' "$penv" 2>/dev/null || stat -f '%Lp' "$penv")"
  if [ "$mode" != "600" ]; then
    printf 'ccx: warning: %s has mode %s (expected 600); run: chmod 600 %s\n' "$penv" "$mode" "$penv" >&2
  fi

  local isolate=false provider="" router="" key val
  local -a exports=()
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | '#'*) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    case "$key" in
      CCX_ISOLATE) isolate="$val" ;;
      CCX_PROVIDER) provider="$val" ;;
      CCX_ROUTER) router="$val" ;;
      CCX_*) : ;;
      *) export "$key=$val"; exports+=("$key=$val") ;;
    esac
  done < "$penv"

  if [ "$isolate" = "true" ]; then
    local home; home="$(profile_dir "$name")/home"
    mkdir -p "$home"; chmod 700 "$home"
    export CLAUDE_CONFIG_DIR="$home"
    exports+=("CLAUDE_CONFIG_DIR=$home")
  fi

  # OpenAI-compatible profiles route through a local ccx-router (separate path).
  if [ -n "$router" ]; then
    run_router "$name" "$provider" "$@"
    return
  fi

  if [ "${CCX_DRY_RUN:-}" = "1" ]; then
    printf 'CCX_DRY_RUN profile=%s provider=%s\n' "$name" "$provider"
    local e k
    for e in "${exports[@]}"; do
      k="${e%%=*}"
      case "$k" in
        *TOKEN* | *API_KEY*) printf 'env: %s=%s\n' "$k" "$(mask_token "${e#*=}")" ;;
        *) printf 'env: %s\n' "$e" ;;
      esac
    done
    printf 'exec: %s %s\n' "$CCX_CLAUDE_BIN" "$*"
    exit 0
  fi

  command -v "$CCX_CLAUDE_BIN" >/dev/null 2>&1 \
    || die "claude not found (looked for '$CCX_CLAUDE_BIN'). Install Claude Code or set CCX_CLAUDE_BIN."
  exec "$CCX_CLAUDE_BIN" "$@"
}

cmd_show() {
  local name="${1:-}"; [ -n "$name" ] || die "show: profile name required"
  local penv; penv="$(profile_env "$name")"
  [ -f "$penv" ] || die "unknown profile: $name"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ANTHROPIC_AUTH_TOKEN=* | ANTHROPIC_API_KEY=* | CCX_UPSTREAM_API_KEY=*)
        printf '%s=%s\n' "${line%%=*}" "$(mask_token "${line#*=}")" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$penv"
}

cmd_edit() {
  local name="${1:-}"; [ -n "$name" ] || die "edit: profile name required"
  local penv; penv="$(profile_env "$name")"
  [ -f "$penv" ] || die "unknown profile: $name"
  "${EDITOR:-vi}" "$penv"
  chmod 600 "$penv"
}

cmd_rm() {
  local name="${1:-}"; [ -n "$name" ] || die "rm: profile name required"
  local pdir; pdir="$(profile_dir "$name")"
  [ -d "$pdir" ] || die "unknown profile: $name"
  if [ "${CCX_YES:-}" != "1" ]; then
    printf 'Remove profile "%s" and its isolated config? [y/N] ' "$name"
    local ans; read -r ans
    case "$ans" in y | Y) ;; *) printf 'Aborted.\n'; return 0 ;; esac
  fi
  rm -rf "$pdir"
  printf 'Removed profile "%s".\n' "$name"
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    help | -h | --help) cmd_help ;;
    list | ls) cmd_list ;;
    new) shift; cmd_new "$@" ;;
    show) shift; cmd_show "$@" ;;
    edit) shift; cmd_edit "$@" ;;
    rm | remove | delete) shift; cmd_rm "$@" ;;
    __freeport) pick_free_port; printf '\n' ;;
    __apikey) gen_apikey; printf '\n' ;;
    *) cmd_run "$@" ;;
  esac
}

main "$@"
