{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccx",
  "version": "0.1.0",
  "identifier": "com.ulyssestwo.ccx",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ccx", "width": 900, "height": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
